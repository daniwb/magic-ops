+import pathlib
+import sys
+import unittest
+
+
+sys.path.insert(0, str(pathlib.Path(__file__).parent))
+import reparse  # noqa: E402
+
+
+class TicketSpecTargetPlayerDrawTest(unittest.TestCase):
+    def map_draw(self, text):
+        verb, args = reparse.O.parse_atom(text)
+        self.assertEqual(verb, "p_draw")
+        return reparse.map_atom(verb, args, kind="oneshot")
+
+    def test_target_player_uses_real_player_target(self):
+        self.assertEqual(
+            self.map_draw("Target player draws two cards."),
+            ("draw", {"amount": 2}, {"filter": "player"}),
+        )
+
+    def test_target_opponent_retains_existing_scope(self):
+        self.assertEqual(
+            self.map_draw("Target opponent draws two cards."),
+            ("draw", {"amount": 2, "target": "opponent"}, None),
+        )
+
+    def test_each_opponent_retains_existing_scope(self):
+        self.assertEqual(
+            self.map_draw("Each opponent draws two cards."),
+            ("draw", {"amount": 2, "target": "opponent"}, None),
+        )
+
+    def test_each_player_is_not_collapsed_to_one_target(self):
+        self.assertIsNone(self.map_draw("Each player draws two cards."))
+
+    def test_that_player_remains_an_unbound_referent(self):
+        self.assertIsNone(self.map_draw("That player draws two cards."))
+
+
+if __name__ == "__main__":
+    unittest.main()
