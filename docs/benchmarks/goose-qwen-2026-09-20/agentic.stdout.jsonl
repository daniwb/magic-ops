us != nil {\n\t\t\t\tgs.ProcessTriggeredAbilities(NewEvent(EventTapped).WithSource(card).WithPlayer(card.Controller))\n\t\t\t\tgs.ProcessTriggeredAbilities(NewEvent(EventBecomesTapped).WithSource(card).WithPlayer(card.Controller))\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\t// no_untap_next_step primitive (ticket engine.auto-no-untap-next-step-\n\t// 565337de28, Quiet Contemplation class): \"tap target creature an\n\t// opponent controls and it doesn't untap during its controller's next\n\t// untap step.\" Same paired shape as tap_referent_doesnt_untap just\n\t// above (the referent is the ability's own already-resolved target) --\n\t// a distinct case name so future reparse rounds can address this exact\n\t// oracle family without disturbing tap_referent_doesnt_untap's own\n\t// callers. A bare \"tap\" with no untap-prevention clause is untouched\n\t// and keeps mapping to the plain \"tap\" case.\n\tif effect == \"no_untap_next_step\" {\n\t\tfor _, tgt := range targets {\n\t\t\tif !tgt.IsCard {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcard, err := gs.Battlefield.GetCard(tgt.CardID)\n\t\t\tif err != nil || card == nil {\n\t\t\t\tcontinue\n\t\t\t}\n\t\t\tcard.Tap()\n\t\t\tcard.SkipNextUntap = true\n\t\t\tif gs.EventBus != nil {\n\t\t\t\tgs.ProcessTriggeredAbilities(NewEvent(EventTapped).WithSource(card).WithPlayer(card.Controller))\n\t\t\t\tgs.ProcessTriggeredAbilities(NewEvent(EventBecomesTapped).WithSource(card).WithPlayer(card.Controller))\n\t\t\t}\n\t\t}\n\t\treturn nil\n\t}\n\t// untap_event_subject primitive (ticket #2885, REPARSE-MAP verb_unmapped:\n\t// untap / \"Whenever a permanent you control enters tapped, untap it.\"\n\t// family — Amulet of Vigor class): the \"it\" here is the triggering\n\t// event's subject (the permanent that just entered tapped), not a\n\t// player-chosen target — untap_target_permanent just above reads\n\t// stackObj.Targets, which a non-targeted ETB trigger never populates.\n\t// Mirrors exile_self_on_death's direct EventCard binding further below\n\t// rather than the generic target_ref==\"event_subject\" rewrite later in\n\t// this function: that rewrite runs after this file's early-return effect\n\t// blocks, so it's unreachable for an effect matched by an earlier \"if\".\n\t// Vanished subject (Rule 608.2b): no event subject -> no-op.\n\tif effect == \"untap_event_subject\" {\n\t\tif stackObj.EventCard == nil {\n\t\t\treturn nil\n\t\t}\n\t\tcard, err := gs.Battlefield.GetCard(stackObj.EventCard.ID)\n\t\tif err != nil || card == nil {\n\t\t\treturn nil\n\t\t}\n\t\tcard.Tapped = false\n\t\treturn nil\n\t}\n\t// search_named_card_multi_zone primitive (ticket #3038, REPARSE-MAP\n\t// verb_unmapped:? / \"search your library and/or graveyard for a card\n\t// named X\" family — Ajani's Aid, Angrath's Fury, Ashiok's Forerunner,\n\t// Basri's Aegis class): the registered tutor primitive's Filter is a\n\t// flat type/subtype string (SEARCH_FILTER_BLOCK excludes `\\bnamed\\b` as\n\t// needing runtime-state matching) and only ever targets the library, so\n\t// an exact-literal-name search across library AND graveyard needs its\n\t// own executor. effectValue[\"name\"] carries the literal card name\n\t// (parser-supplied, out of scope here). No-op if unset or not found in\n\t// either zone; see searchNamedCardMultiZone for the shuffle rule.\n\tif effect == \"search_named_card_multi_zone\" {\n\t\tname, _ := effectValue[\"name\"].(string)\n\t\tgs.searchNamedCardMultiZone(controller, name)\n\t\treturn nil\n\t}\n\t// menace_counter_on_controlled_creature primitive: see\n\t// executeMenaceCounterOnControlledCreature.\n\tif effect == \"menace_counter_on_controlled_creature\" {\n\t\treturn gs.executeMenaceCounterOnControlledCreature(controller)\n\t}\n\t// durable_self_exile primitive (ticket\n\t// engine.auto-durable-self-exile-dd89277b18, Glorious Protector class):\n\t// \"exile any number of <filter> permanents you control until this\n\t// creature leaves the battlefield.\" Delegates entirely to\n\t// executeDurable