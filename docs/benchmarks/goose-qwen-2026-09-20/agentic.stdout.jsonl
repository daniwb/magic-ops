{"type":"message","message":{"id":"msg_22fb715d-19c3-468d-875b-f6b353cdf32f","role":"user","created":1789883303,"content":[{"type":"toolResponse","id":"call_836d3cff064a41c3b5751fc7","toolResult":{"status":"success","value":{"resultType":"complete","content":[{"type":"text","text":"package cards\n\nimport \"testing\"\n\n// Coverage-honesty gate (phase.rs pattern: a test that asserts records stay\n// red). Gap markers (\"custom\", \"tiered\") are registered vocabulary so the\n// ratchet linter stays green, but a record carrying one is by definition not\n// fully parsed — it must never ship in a playable status.\nfunc TestGapMarkersNeverOnPlayableCards(t *testing.T) {\n\tgapMarkers := map[string]bool{\"custom\": true, \"tiered\": true}\n\t// Reach-guard: the markers must actually be registered — otherwise this\n\t// test could pass vacuously while the vocabulary linter is red.\n\tfor m := range gapMarkers {\n\t\tif _, ok := V2EffectRegistry[m]; !ok {\n\t\t\tt.Fatalf(\"gap marker %q not in V2EffectRegistry — registry_gap_markers.go out of sync\", m)\n\t\t}\n\t}\n\n\tvar hasMarker func(ab *AbilityDSL) bool\n\thasMarker = func(ab *AbilityDSL) bool {\n\t\tif gapMarkers[ab.Effect] {\n\t\t\treturn true\n\t\t}\n\t\tfor i := range ab.Effects {\n\t\t\tif gapMarkers[ab.Effects[i].Effect] {\n\t\t\t\treturn true\n\t\t\t}\n\t\t\tif g := ab.Effects[i].Granted; g != nil && hasMarker(g) {\n\t\t\t\treturn true\n\t\t\t}\n\t\t}\n\t\treturn false\n\t}\n\tcheckFace := func(name string, status CardStatus, abilities []AbilityDSL) int {\n\t\tfound := 0\n\t\tfor i := range abilities {\n\t\t\tif hasMarker(&abilities[i]) {\n\t\t\t\tfound++\n\t\t\t\tif status != StatusNeedsReview && status != StatusUnsupported {\n\t\t\t\t\tt.Errorf(\"gap marker on %q with status %q — a record carrying custom/tiered is not fully parsed and must stay review/unsupported\", name, status)\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\treturn found\n\t}\n\n\tdb := loadWholeDB(t)\n\tseen := 0\n\tfor name, def := range db.Cards {\n\t\tseen += checkFace(name, def.Status, def.Abilities)\n\t\tif def.BackFaceDef != nil {\n\t\t\tseen += checkFace(name+\" (back)\", def.Status, def.BackFaceDef.Abilities)\n\t\t}\n\t}\n\tif seen == 0 {\n\t\tt.Log(\"no gap-marker records in corpus — markers stay registered for future imports\")\n\t}\n}\n=== gap markers ===\npackage cards\n\n// Gap markers — honest-miss-as-value vocabulary (the phase.rs\n// Effect::Unimplemented analog, see docs/phase-rs-factory-analysis.md).\n//\n// A gap marker keeps the parsed part of an ability (e.g. its trigger) and\n// carries the un-parseable clause verbatim in value.effect_text instead of\n// silently dropping it or discarding the whole record. Records carrying one\n// must never ship in a playable status — enforced by\n// TestGapMarkersNeverOnPlayableCards (lint_gap_markers_test.go), the\n// coverage-honesty companion to this registration.\nfunc init() {\n\tregEffect(\"custom\", Primitive{\n\t\tExecutor:  \"explicit gap marker, no executor by design — game/ability_effects.go's default arm no-ops unknown effects (mirrors phase.rs resolve_effect's Unimplemented => Ok(())). value.effect_text carries the verbatim unparsed clause for later clustering/re-parse. Entered the corpus via parser-spine round 5 imports (e843f9bfa) unregistered; registered 2026-08-10 to close the vocabulary ratchet the way the linter demands (registry, not the frozen grandfather list).\",\n\t\tShapeTest: \"TestGapMarkersNeverOnPlayableCards\",\n\t})\n\tregEffect(\"tiered\", Primitive{\n\t\tExecutor:  \"gap marker for the unbuilt Tiered keyword mechanic (Fire Magic, TLA set) — same no-op / never-playable contract as \\\"custom\\\". Replace this entry with a real executor when a tiered engine round lands (regEffect panics on duplicate, so the swap is forced to be explicit).\",\n\t\tShapeTest: \"TestGapMarkersNeverOnPlayableCards\",\n\t})\n}","annotations":{"priority":0.0}}],"structuredContent":{"stdout":"package cards\n\nimport \"testing\"\n\n// Coverage-honesty 