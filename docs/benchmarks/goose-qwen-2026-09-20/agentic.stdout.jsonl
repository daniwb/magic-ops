{"type":"message","message":{"id":"msg_7e4e7d2b-951d-48b6-a6f2-421a7eb9db07","role":"user","created":1789882927,"content":[{"type":"toolResponse","id":"call_8f919b4da5eb45d4aa4dbf8e","toolResult":{"status":"success","value":{"resultType":"complete","content":[{"type":"text","text":"package game\n\nimport \"testing\"\n\n// TestFactoryNGFreezeUntilNextUntap exercises the tap_referent_doesnt_untap\n// primitive (ticket engine.auto-freeze-until-next-untap-2a686b6439, Kashi-Tribe\n// Warriors class): \"tap that creature and it doesn't untap during its\n// controller's next untap step.\" The paired atom taps the target AND marks it\n// with Card.SkipNextUntap (the existing exert-mechanic flag), consumed\n// one-shot by Zone.UntapAll during the controller's next untap step. A\n// sibling permanent controlled by the same player untaps normally, and a\n// LATER untap step (with no new mark) untaps the target normally too.\nfunc TestFactoryNGFreezeUntilNextUntap(t *testing.T) {\n\tgs := NewGame(\"P0\", \"P1\", false)\n\n\tsource := NewCreature(\"Freeze Test Caster\", ManaCost{}, 1, 1, 1)\n\tsource.Owner, source.Controller = 0, 0\n\tgs.Battlefield.AddCard(source)\n\n\ttarget := NewCreature(\"Freeze Test Target\", ManaCost{}, 2, 2, 2)\n\ttarget.Owner, target.Controller = 1, 1\n\tgs.Battlefield.AddCard(target)\n\n\tsibling := NewCreature(\"Freeze Test Sibling\", ManaCost{}, 2, 2, 2)\n\tsibling.Owner, sibling.Controller = 1, 1\n\tsibling.Tapped = true\n\tgs.Battlefield.AddCard(sibling)\n\n\tstackObj := &StackObject{\n\t\tIsAbility:   true,\n\t\tText:        \"tap_referent_doesnt_untap\",\n\t\tController:  0,\n\t\tCard:        source,\n\t\tEffectValue: map[string]interface{}{},\n\t\tTargets:     []Target{{Type: TargetCreature, CardID: target.ID, IsCard: true}},\n\t}\n\n\tif err := gs.ExecuteAbilityEffect(stackObj); err != nil {\n\t\tt.Fatalf(\"ExecuteAbilityEffect: %v\", err)\n\t}\n\n\tif !target.Tapped {\n\t\tt.Fatalf(\"expected target to be tapped by tap_referent_doesnt_untap\")\n\t}\n\tif !target.SkipNextUntap {\n\t\tt.Fatalf(\"expected target to be marked SkipNextUntap\")\n\t}\n\n\t// Controller's next untap step: target stays tapped, sibling untaps normally.\n\tif err := ExecuteUntapStep(gs.Players[1], gs.Battlefield); err != nil {\n\t\tt.Fatalf(\"ExecuteUntapStep: %v\", err)\n\t}\n\n\tif !target.Tapped {\n\t\tt.Fatalf(\"target should have stayed tapped through its frozen untap step\")\n\t}\n\tif sibling.Tapped {\n\t\tt.Fatalf(\"sibling should have untapped normally\")\n\t}\n\tif target.SkipNextUntap {\n\t\tt.Fatalf(\"SkipNextUntap should be one-shot and cleared after being consumed\")\n\t}\n\n\t// A LATER untap step, with no new freeze, must untap the target normally.\n\tif err := ExecuteUntapStep(gs.Players[1], gs.Battlefield); err != nil {\n\t\tt.Fatalf(\"ExecuteUntapStep (second): %v\", err)\n\t}\n\tif target.Tapped {\n\t\tt.Fatalf(\"freeze mark persisted into a later untap step\")\n\t}\n}\n=== registry for 2a686b6439 ===\n\nCommand exited with code 1","annotations":{"priority":0.0}}],"structuredContent":{"stdout":"package game\n\nimport \"testing\"\n\n// TestFactoryNGFreezeUntilNextUntap exercises the tap_referent_doesnt_untap\n// primitive (ticket engine.auto-freeze-until-next-untap-2a686b6439, Kashi-Tribe\n// Warriors class): \"tap that creature and it doesn't untap during its\n// controller's next untap step.\" The paired atom taps the target AND marks it\n// with Card.SkipNextUntap (the existing exert-mechanic flag), consumed\n// one-shot by Zone.UntapAll during the controller's next untap step. A\n// sibling permanent controlled by the same player untaps normally, and a\n// LATER untap step (with no new mark) untaps the target normally too.\nfunc TestFactoryNGFreezeUntilNextUntap(t *testing.T) {\n\tgs := NewGame(\"P0\", \"P1\", false)\n\n\tsource := NewCreature(\"Freeze Test Caster\", ManaCost{}, 1, 1, 1)\n\tsource.Owner, source.Controller = 0, 0\n\tgs.Battlefield.AddCard(source)\n\n\ttarget := NewCreature(\"Freeze Test Target\", ManaCost{}, 2, 2, 2)\n\ttarget.Owner, target.Controller = 1, 1\n\tgs.Battlefield.AddCard(target)\n\n\tsibling := NewCreature(\"Freeze Test Sibling\", ManaCost{}, 2, 2, 2)\n\tsibling.Owner, sibling.Controller = 1, 1\n\tsibling.Tapped = true\n\tgs.Battlefield.AddCard(sibling)\n\n\tstackObj := &StackObject{\n\t\tIsAbility:   true,\n\t\tText:        \"tap_referent_doesnt_untap\",\n\t\tController:  0,\n\t\tCard:        source,\n\t\tEffectValue: map[string]interface{}{},\n\t\tTargets:     []Target{{Type: TargetCreature, CardID: target.ID, IsCard: true}},\n\t}\n\n\tif err := gs.ExecuteAbilityEffect(stackObj); err != nil {\n\t\tt.Fatalf(\"ExecuteAbilityEffect: %v\", err)\n\t}\n\n\tif !target.Tapped {\n\t\tt.Fatalf(\"expected target to be tapped by tap_referent_doesnt_untap\")\n\t}\n\tif !target.SkipNextUntap {\n\t\tt.Fatalf(\"expected target to be marked SkipNextUntap\")\n\t}\n\n\t// Controller's next untap step: target stays tapped, sibling untaps normally.\n\tif err := ExecuteUntapStep(gs.Players[1], gs.Battlefield); err != nil {\n\t\tt.Fatalf(\"ExecuteUntapStep: %v\", err)\n\t}\n\n\tif !target.Tapped {\n\t\tt.Fatalf(\"target should have stayed tapped through its frozen untap step\")\n\t}\n\tif sibling.Tapped {\n\t\tt.Fatalf(\"sibling should have untapped normally\")\n\t}\n\tif target.SkipNextUntap {\n\t\tt.Fatalf(\"SkipNextUntap should be one-shot and cleared after being consumed\")\n\t}\n\n\t// A LATER untap step, with no new freeze, must untap the target normally.\n\tif err := ExecuteUntapStep(gs.Players[1], gs.Battlefield); err != nil {\n\t\tt.Fatalf(\"ExecuteUntapStep (second): %v\", err)\n\t}\n\tif target.Tapped {\n\t\tt.Fatalf(\"freeze mark persisted into a later untap step\")\n\t}\n}\n=== registry for 2a686b6439 ===","stderr":"","exit_code":1},"isError":true}}}],"metadata":{"userVisible":true,"agentVisible":true}}}
