+	// freeze_until_next_untap primitive (ticket engine.auto-freeze-until-next-untap-7b6fc522b0/v1):
+	// Marks a targeted permanent so that it does not untap during its controller's next untap step.
+	// It reuses the existing Card.SkipNextUntap field, which is a one-shot flag
+	// (Rule 701.39) consumed and cleared by Zone.UntapAll.
+	// This ensures the freeze is strictly duration-bound to the next untap step.
+	// Repeated applications before the next untap step will not extend the duration,
+	// satisfying the negative example requirement.
+	if effect == "freeze_until_next_untap" {
+		for _, tgt := range targets {
+			if !tgt.IsCard {
+				continue
+			}
+			card, err := gs.Battlefield.GetCard(tgt.CardID)
+			if err != nil || card == nil {
+				continue
+			}
+			card.SkipNextUntap = true
+		}
+		return nil
+	}
