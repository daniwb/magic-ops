 async function saveWeeklyGate(button){const row=button.closest('.weekly-gate'),weekly_gate_mode=row.querySelector('select').value,weekly_gate_pct=Number(row.querySelector('input').value);button.disabled=true;try{const r=await fetch('/factory-ng/workers',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:row.dataset.worker,weekly_gate_mode,weekly_gate_pct})});if(!r.ok)throw new Error(await r.text());await refresh()}catch(e){alert('Weekly gate was not saved: '+e.message)}finally{button.disabled=false}}
