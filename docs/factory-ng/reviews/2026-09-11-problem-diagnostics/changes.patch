 function showTab(name){document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('selected',x.dataset.tab===name));$('#tabSummary').classList.toggle('hidden',name!=='summary');$('#tabGates').classList.toggle('hidden',name!=='gates');$('#tabJson').classList.toggle('hidden',name!=='json')}function closeDetail(){$('#detailModal').close()}function backdropClose(e){if(e.target===$('#detailModal'))closeDetail()}document.addEventListener('keydown',e=>{if(e.key==='Escape'&&$('#detailModal').open)closeDetail()});
 async function refreshData(){if(dataRequest)dataRequest.abort();const request=new AbortController();dataRequest=request;const q=new URLSearchParams({filter:workFilter,focus:focusId,search:$('#ticketSearch').value,attempts:$('#attemptsPanel').open?'1':'0',jobs_offset:offsets.jobs,attempts_offset:offsets.attempts,integrations_offset:offsets.integrations});try{const r=await fetch('/factory-ng/data?'+q,{signal:request.signal});if(!r.ok)throw new Error(await r.text());const data=await r.json();if(dataRequest!==request)return;view.data=data;const tickets=data.tickets||[];$('#focusTicket').innerHTML=tickets.map(t=>`<option value="${esc(t.id)}">${esc(t.id)}</option>`).join('');focusId=data.focus;renderDependencyGraph(focusId);renderWork();renderIntegrations();renderAttempts();['jobs','attempts','integrations'].forEach(renderPager);if(view.status.state)renderRun();const age=Math.max(0,Math.round((Date.now()-Date.parse(data.indexed_at))/1000));$('#dataFreshness').textContent='History updated '+age+'s ago'+(data.invalid_files?.length?' · '+data.invalid_files.length+' unreadable source records':'');$('#dataFreshness').className=age>60||data.invalid_files?.length?'error tiny':'muted tiny'}catch(e){if(e.name!=='AbortError'){$('#dataFreshness').textContent='History unavailable: '+e.message;$('#dataFreshness').className='error tiny'}}finally{if(dataRequest===request)dataRequest=null}}
 async function refresh(){if(refreshing)return;refreshing=true;const failures=[];try{await Promise.allSettled([refreshData(),...['cards','status','workers','limits'].map(async key=>{try{const r=await fetch('/factory-ng/'+key,{signal:AbortSignal.timeout(25000)});if(!r.ok)throw new Error(r.status);view[key]=await r.json();if(key==='cards')renderCards();if(key==='status'){renderOperatorNotice();renderCacheMaintenance()}if(key==='workers')renderWorkers();if(key==='limits'||key==='workers')renderLimits();if(view.status.state)renderRun()}catch(e){failures.push(key);console.error(key,e)}})]);$('#stamp').textContent=failures.length?'Unavailable: '+failures.join(', '):'updated '+new Date().toLocaleTimeString()}finally{refreshing=false}}
