+func primitiveMetadata(path string, expr ast.Expr) map[string]string {
+	body, ok := expr.(*ast.CompositeLit)
+	if !ok {
+		return nil
+	}
+	result := map[string]string{"path": path}
+	for _, field := range body.Elts {
+		kv, ok := field.(*ast.KeyValueExpr)
+		if !ok {
+			continue
+		}
+		key, ok := kv.Key.(*ast.Ident)
+		if !ok {
+			continue
+		}
+		switch key.Name {
+		case "Executor":
+			result["executor"] = literal(kv.Value)
+		case "ShapeTest":
+			result["shape_test"] = literal(kv.Value)
+		}
+	}
+	if result["executor"] == "" || result["shape_test"] == "" {
+		return nil
+	}
+	return result
+}
