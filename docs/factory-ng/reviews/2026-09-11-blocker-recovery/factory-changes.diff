+def annotate_dependency_blockers(jobs, tickets):
+    """Describe current child states without changing lifecycle or retry budgets."""
+    children = {}
+    for key, ticket in tickets.items():
+        if ticket.get('work_type') != 'engine':
+            continue
+        for parent in ticket.get('parents', []):
+            children.setdefault(parent, set()).add(key)
+    for key, job in jobs.items():
+        old = job.pop('dependency_blocker', None)
+        if old and job.get('waiting_reason') == old.get('reason'):
+            job.pop('waiting_reason', None)
+        if job.get('state') != 'blocked' or job.get('superseded_by'):
+            continue
+        current = {}
+        for child in children.get(key, ()):
+            visited = set()
+            while child not in visited and jobs.get(child, {}).get('superseded_by'):
+                visited.add(child)
+                child = jobs[child]['superseded_by']
+            current[child] = jobs.get(child, {}).get('state', 'not_enqueued')
+        states = set(current.values())
+        if states & {'queued', 'working', 'awaiting_integration', 'integrating'}:
+            reason = 'Engine dependency is queued, running, or awaiting integration'
+        elif 'completed' in states:
+            reason = 'Engine dependency completed; waiting for bounded Map resume admission'
+        elif current:
+            reason = 'Engine dependency has no active successor: ' + ', '.join(sorted(states))
+        else:
+            reason = 'Validated capability demand is waiting for Engine ticket admission'
+        job['dependency_blocker'] = {'reason': reason, 'children': current}
+        job['waiting_reason'] = reason
 
 
