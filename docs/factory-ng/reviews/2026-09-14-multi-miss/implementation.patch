+             mock.patch.object(self.m, 'registry_effects', return_value=self.effects), \
+             mock.patch.object(self.m, 'ProducerCache', side_effect=lambda _: ProducerCache(root / 'cache.db')), \
+             contextlib.redirect_stdout(out):
+            self.m.main()
