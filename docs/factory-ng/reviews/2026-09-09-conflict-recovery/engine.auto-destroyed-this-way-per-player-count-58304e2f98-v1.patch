@@ -0,0 +1,50 @@
+package game
+
+import "testing"
+
+// TestFactoryNGDestroyedThisWayPerPlayerCount exercises
+// destroyed_this_way_per_player_count (ticket
+// engine.auto-destroyed-this-way-per-player-count-58304e2f98, Builder's
+// Bane class): "Destroy X target artifacts. ~ deals damage to each player
+// equal to the number of artifacts they controlled that were put into a
+// graveyard this way." Player 0 controls one artifact destroyed this way,
+// player 1 controls two, so player 0 must take 1 damage and player 1 must
+// take 2 -- not one flat count applied to both.
+func TestFactoryNGDestroyedThisWayPerPlayerCount(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+	gs.seqTally = map[string]int{}
+
+	p0Artifact := &Card{ID: "bb-art-p0", Name: "Test Cog", Type: CardType("Artifact"), Owner: 0, Controller: 0}
+	p1ArtifactA := &Card{ID: "bb-art-p1a", Name: "Test Sprocket A", Type: CardType("Artifact"), Owner: 1, Controller: 1}
+	p1ArtifactB := &Card{ID: "bb-art-p1b", Name: "Test Sprocket B", Type: CardType("Artifact"), Owner: 1, Controller: 1}
+	gs.Battlefield.AddCard(p0Artifact)
+	gs.Battlefield.AddCard(p1ArtifactA)
+	gs.Battlefield.AddCard(p1ArtifactB)
+
+	targets := []Target{
+		{IsCard: true, CardID: p0Artifact.ID},
+		{IsCard: true, CardID: p1ArtifactA.ID},
+		{IsCard: true, CardID: p1ArtifactB.ID},
+	}
+
+	gs.noteDestroyedArtifactsPerController(targets)
+	for _, tgt := range targets {
+		if err := DestroyTarget(tgt, gs); err != nil {
+			t.Fatalf("DestroyTarget(%s): %v", tgt.CardID, err)
+		}
+	}
+
+	life0Before := gs.Players[0].Life
+	life1Before := gs.Players[1].Life
+
+	if err := gs.executeDamageEachPlayerArtifactsDestroyedThisWay(); err != nil {
+		t.Fatalf("executeDamageEachPlayerArtifactsDestroyedThisWay: %v", err)
+	}
+
+	if got := life0Before - gs.Players[0].Life; got != 1 {
+		t.Fatalf("player 0 controlled 1 artifact destroyed this way, want 1 damage, got %d", got)
+	}
+	if got := life1Before - gs.Players[1].Life; got != 2 {
+		t.Fatalf("player 1 controlled 2 artifacts destroyed this way, want 2 damage, got %d", got)
+	}
+}
