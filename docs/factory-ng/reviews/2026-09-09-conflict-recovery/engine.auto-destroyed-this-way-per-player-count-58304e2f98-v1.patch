 // kind above: that kind's filter vocabulary has no tapped-state
 // predicate yet, and this primitive's scope is limited to wiring exactly
 // this one shape through.
+// isArtifactPermanent reports whether perm is an artifact, matching the
+// same primary-type-or-subtype check countTappedArtifactsControlledBy uses
+// just below.
+func isArtifactPermanent(perm *Card) bool {
+	if perm == nil {
+		return false
+	}
+	if strings.EqualFold(string(perm.Type), "Artifact") {
+		return true
+	}
+	for _, st := range perm.SubTypes {
+		if strings.EqualFold(st, "Artifact") {
+			return true
+		}
+	}
+	return false
+}
