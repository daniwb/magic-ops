+package game
+
+import "testing"
+
+// TestFactoryNGReturnExiledCardsWithSource covers the return_exiled_cards_with_source
+// primitive (Promise of Tomorrow class): when a source permanent that has
+// exiled cards with itself is sacrificed, everything it exiled must return to
+// the battlefield under its controller's control.
+func TestFactoryNGReturnExiledCardsWithSource(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	source := NewCard("Test Promise of Tomorrow", CardType("Enchantment"), ManaCost{}, 0)
+	source.Controller = 0
+	gs.Battlefield.AddCard(source)
+	gs.RegisterCardAbilities(source)
+
+	victim := NewCreature("Test Fallen Beast", ManaCost{}, 2, 2, 0)
+	victim.Owner, victim.Controller = 0, 0
+	gs.Battlefield.AddCard(victim)
+	gs.RegisterCardAbilities(victim)
+
+	// Exile the creature "with" the source (durable_self_exile family: the
+	// "whenever a creature you control dies, exile it" half of the card).
+	if err := gs.executeDurableSelfExileEffect(source, 0, ""); err != nil {
+		t.Fatalf("executeDurableSelfExileEffect: %v", err)
+	}
+	if len(source.StashedExileIDs) != 1 {
+		t.Fatalf("expected 1 stashed exile id, got %d", len(source.StashedExileIDs))
+	}
+	if _, err := gs.Players[0].Exile.GetCard(victim.ID); err != nil {
+		t.Fatalf("expected victim to be in exile: %v", err)
+	}
+	if _, err := gs.Battlefield.GetCard(victim.ID); err == nil {
+		t.Fatalf("victim should have left the battlefield")
+	}
+
+	// Sacrifice the source and return everything it exiled to the
+	// battlefield under its controller's control.
+	if err := gs.executeSacrificeSelfReturnExiled(source, 0); err != nil {
+		t.Fatalf("executeSacrificeSelfReturnExiled: %v", err)
+	}
+
+	if _, err := gs.Battlefield.GetCard(source.ID); err == nil {
+		t.Fatalf("source should have been sacrificed off the battlefield")
+	}
+	if _, err := gs.Players[0].Graveyard.GetCard(source.ID); err != nil {
+		t.Fatalf("source should be in its owner's graveyard: %v", err)
+	}
+	if len(source.StashedExileIDs) != 0 {
+		t.Fatalf("stashed exile ids should be cleared, got %v", source.StashedExileIDs)
+	}
+	if _, err := gs.Players[0].Exile.GetCard(victim.ID); err == nil {
+		t.Fatalf("exiled card should no longer be in exile")
+	}
+	returned, err := gs.Battlefield.GetCard(victim.ID)
+	if err != nil {
+		t.Fatalf("exiled card should have returned to the battlefield: %v", err)
+	}
+	if returned.Controller != 0 {
+		t.Fatalf("returned card should be under its source's controller's control, got controller %d", returned.Controller)
+	}
+}
