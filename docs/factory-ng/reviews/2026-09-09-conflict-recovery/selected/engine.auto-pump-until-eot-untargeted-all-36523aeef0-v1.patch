+package game
+
+import "testing"
+
+// ticket engine.auto-pump-until-eot-untargeted-all-36523aeef0 (Tip the
+// Scales class): "When you do, all creatures get -X/-X until end of turn"
+// carries no target at all, so it must reach executePumpEffect's existing
+// effectValue["all"] mass-filter branch instead of tripping the
+// pump_until_eot no-target guard. Exercised through the same
+// GameState.ExecuteAbilityEffect(stackObj) entry point stack resolution
+// uses in production.
+func TestFactoryNGPumpUntilEotUntargetedAll(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	mine := NewCreature("Factory NG Mine Beast", ManaCost{}, 3, 3, 0)
+	mine.Owner, mine.Controller = 0, 0
+	gs.Battlefield.AddCard(mine)
+
+	theirs := NewCreature("Factory NG Their Beast", ManaCost{}, 2, 2, 1)
+	theirs.Owner, theirs.Controller = 1, 1
+	gs.Battlefield.AddCard(theirs)
+
+	source := NewCreature("Factory NG Sac Fodder", ManaCost{}, 1, 1, 2)
+
+	countEffects := func() int { return len(gs.EffectManager.effects) }
+	before := countEffects()
+
+	untargetedAll := &StackObject{
+		IsAbility:  true,
+		Text:       "pump_until_eot",
+		Controller: 0,
+		Card:       source,
+		EffectValue: map[string]interface{}{
+			"all":        true,
+			"controller": "all",
+			"power":      -2,
+			"toughness":  -2,
+		},
+	}
+	if err := gs.ExecuteAbilityEffect(untargetedAll); err != nil {
+		t.Fatalf("ExecuteAbilityEffect (untargeted all): %v", err)
+	}
+
+	affected := map[string]bool{}
+	for _, eff := range gs.EffectManager.effects[before:] {
+		if eff.UntilEOT && eff.PowerMod == -2 && eff.ToughnessMod == -2 {
+			affected[eff.AffectsSpecific] = true
+		}
+	}
+	if !affected[mine.ID] {
+		t.Fatalf("untargeted pump_until_eot with all=true did not affect controller's own creature")
+	}
+	if !affected[theirs.ID] {
+		t.Fatalf("untargeted pump_until_eot with all=true did not affect opponent's creature")
+	}
+
+	// Negative example: single-target pump_until_eot with no target
+	// supplied and no "all" flag stays a no-op (unchanged behavior for the
+	// printed-targeted form).
+	before2 := countEffects()
+	noTarget := &StackObject{
+		IsAbility:   true,
+		Text:        "pump_until_eot",
+		Controller:  0,
+		Card:        source,
+		EffectValue: map[string]interface{}{"power": -1, "toughness": -1},
+	}
+	if err := gs.ExecuteAbilityEffect(noTarget); err != nil {
+		t.Fatalf("ExecuteAbilityEffect (no target, no all): %v", err)
+	}
+	if countEffects() != before2 {
+		t.Fatalf("targeted pump_until_eot with no target and no all=true should remain a no-op")
+	}
+}
