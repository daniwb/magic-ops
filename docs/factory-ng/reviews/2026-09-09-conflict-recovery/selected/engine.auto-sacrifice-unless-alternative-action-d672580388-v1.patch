+package game
+
+import "testing"
+
+// factory-ng ticket d672580388: "sacrifice ~ unless you return a basic land
+// card from your graveyard to your hand" (Harvest Wurm class).
+func TestFactoryNGSacrificeUnlessAlternativeAction(t *testing.T) {
+	t.Run("basic land available, source survives", func(t *testing.T) {
+		gs := NewGame("P0", "P1", false)
+		wurm := NewCreature("Factory NG Harvest Wurm", ManaCost{}, 5, 5, 5)
+		wurm.Owner, wurm.Controller = 0, 0
+		gs.Battlefield.AddCard(wurm)
+
+		land := &Card{ID: "factory-ng-d672580388-land", Name: "Forest", Type: TypeLand, IsBasic: true, SubTypes: []string{"Forest"}}
+		land.Owner, land.Controller = 0, 0
+		gs.Players[0].Graveyard.AddCard(land)
+
+		if err := gs.executeSacrificeUnlessReturnBasicLand(0, wurm); err != nil {
+			t.Fatalf("executeSacrificeUnlessReturnBasicLand: %v", err)
+		}
+
+		if _, err := gs.Battlefield.GetCard(wurm.ID); err != nil {
+			t.Fatalf("source was sacrificed even though a basic land was available to return: %v", err)
+		}
+		for _, c := range gs.Players[0].Graveyard.Cards {
+			if c.ID == land.ID {
+				t.Fatalf("basic land was not removed from graveyard")
+			}
+		}
+		found := false
+		for _, c := range gs.Players[0].Hand.Cards {
+			if c.ID == land.ID {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatalf("basic land was not returned to hand")
+		}
+	})
+
+	t.Run("no basic land available, source is sacrificed", func(t *testing.T) {
+		gs := NewGame("P0", "P1", false)
+		wurm := NewCreature("Factory NG Harvest Wurm No Land", ManaCost{}, 5, 5, 5)
+		wurm.Owner, wurm.Controller = 0, 0
+		gs.Battlefield.AddCard(wurm)
+
+		if err := gs.executeSacrificeUnlessReturnBasicLand(0, wurm); err != nil {
+			t.Fatalf("executeSacrificeUnlessReturnBasicLand: %v", err)
+		}
+
+		if _, err := gs.Battlefield.GetCard(wurm.ID); err == nil {
+			t.Fatalf("source was not sacrificed despite no basic land being available")
+		}
+		found := false
+		for _, c := range gs.Players[0].Graveyard.Cards {
+			if c.ID == wurm.ID {
+				found = true
+			}
+		}
+		if !found {
+			t.Fatalf("sacrificed source was not moved to the graveyard")
+		}
+	})
+}
