+package game
+
+import "testing"
+
+// TestFactoryNGSacrificeSource covers the sacrifice_source ability effect
+// (ticket engine.auto-sacrifice-source-d0c00a2e90, Monkey Cage class:
+// "sacrifice this artifact and create X ... tokens"). Distinguishes it from
+// the "sacrifice" effect (executeSacrificeFiltered), which lets the
+// controller choose among OTHER matching permanents.
+func TestFactoryNGSacrificeSource(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	source := NewCard("Factory NG Cage Test", CardType("Artifact"), ManaCost{}, 0)
+	source.Controller = 0
+	gs.Battlefield.AddCard(source)
+
+	other := NewCard("Factory NG Bystander Relic", CardType("Artifact"), ManaCost{}, 0)
+	other.Controller = 0
+	gs.Battlefield.AddCard(other)
+
+	stackObj := &StackObject{
+		IsAbility:   true,
+		Text:        "sacrifice_source",
+		Controller:  0,
+		Card:        source,
+		EffectValue: map[string]interface{}{},
+	}
+	if err := gs.ExecuteAbilityEffect(stackObj); err != nil {
+		t.Fatalf("ExecuteAbilityEffect: %v", err)
+	}
+
+	if _, err := gs.Battlefield.GetCard(source.ID); err == nil {
+		t.Fatalf("source artifact still on battlefield after sacrifice_source effect")
+	}
+	// Negative example: a DIFFERENT artifact the same player controls
+	// must be untouched — sacrifice_source only ever sacrifices its own
+	// source, never another matching permanent.
+	if _, err := gs.Battlefield.GetCard(other.ID); err != nil {
+		t.Fatalf("unrelated artifact was removed instead of the source: %v", err)
+	}
+}
