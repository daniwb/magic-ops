@@ -0,0 +1,111 @@
+package game
+
+import "testing"
+
+// TestFactoryNGDestroyAttachedToReferent exercises the
+// destroy_attached_to_referent primitive (ticket
+// engine.auto-destroy-attached-to-referent-d32bfbcd7a, Turn to Slag class:
+// "~ deals 5 damage to target creature. Destroy all Equipment attached to
+// that creature."). Only Equipment attached to the cross-atom referent
+// creature is destroyed; Equipment attached to a different creature, and
+// the referent creature itself, must survive.
+func TestFactoryNGDestroyAttachedToReferent(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	source := NewCreature("Turn to Slag Shape Source", ManaCost{}, 0, 0, 0)
+	source.Owner, source.Controller = 0, 0
+	gs.Battlefield.AddCard(source)
+
+	target := NewCreature("Slag Target Creature", ManaCost{}, 2, 2, 1)
+	target.Owner, target.Controller = 1, 1
+	gs.Battlefield.AddCard(target)
+
+	attachedEquipment := NewCard("Slag Bound Blade", TypeArtifact, ManaCost{}, 1)
+	attachedEquipment.SubTypes = []string{"Equipment"}
+	gs.Battlefield.AddCard(attachedEquipment)
+	if err := attachedEquipment.AttachTo(target); err != nil {
+		t.Fatalf("AttachTo: %v", err)
+	}
+
+	other := NewCreature("Bystander Creature", ManaCost{}, 2, 2, 1)
+	other.Owner, other.Controller = 1, 1
+	gs.Battlefield.AddCard(other)
+
+	looseEquipment := NewCard("Loose Blade", TypeArtifact, ManaCost{}, 1)
+	looseEquipment.SubTypes = []string{"Equipment"}
+	gs.Battlefield.AddCard(looseEquipment)
+	if err := looseEquipment.AttachTo(other); err != nil {
+		t.Fatalf("AttachTo: %v", err)
+	}
+
+	// Arm the cross-atom referent slot the way effect_sequence.go's
+	// noteSeqReferent does once a preceding atom (the "deals 5 damage to
+	// target creature" atom) has acted on the target.
+	gs.seqSlotsStr = map[string]string{"referent": target.ID}
+
+	obj := &StackObject{
+		Card:        source,
+		Controller:  0,
+		IsAbility:   true,
+		Text:        "destroy",
+		EffectValue: map[string]interface{}{"all": true, "filter": "equipment", "attached_to_referent": true},
+	}
+	if err := gs.ExecuteAbilityEffect(obj); err != nil {
+		t.Fatalf("ExecuteAbilityEffect(destroy attached_to_referent): %v", err)
+	}
+
+	if _, err := gs.Battlefield.GetCard(attachedEquipment.ID); err == nil {
+		t.Fatalf("equipment attached to the referent creature was not destroyed")
+	}
+	if _, err := gs.Battlefield.GetCard(looseEquipment.ID); err != nil {
+		t.Fatalf("equipment attached to a DIFFERENT creature was destroyed (scoping must not sweep unrelated equipment)")
+	}
+	if _, err := gs.Battlefield.GetCard(target.ID); err != nil {
+		t.Fatalf("the referent creature itself was destroyed; only attached Equipment should be")
+	}
+}
+
+// TestFactoryNGDestroyAttachedToReferent_UnscopedStillSweepsAll confirms the
+// ticket's negative example: "Destroy all Equipment" with no
+// attached_to_referent flag must still destroy every Equipment on the
+// battlefield, not just ones attached to some referent.
+func TestFactoryNGDestroyAttachedToReferent_UnscopedStillSweepsAll(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	source := NewCreature("Wrath Shape Source", ManaCost{}, 0, 0, 0)
+	source.Owner, source.Controller = 0, 0
+	gs.Battlefield.AddCard(source)
+
+	unattached := NewCard("Free Standing Blade", TypeArtifact, ManaCost{}, 1)
+	unattached.SubTypes = []string{"Equipment"}
+	gs.Battlefield.AddCard(unattached)
+
+	creature := NewCreature("Some Creature", ManaCost{}, 2, 2, 1)
+	creature.Owner, creature.Controller = 1, 1
+	gs.Battlefield.AddCard(creature)
+
+	attached := NewCard("Attached Blade", TypeArtifact, ManaCost{}, 1)
+	attached.SubTypes = []string{"Equipment"}
+	gs.Battlefield.AddCard(attached)
+	if err := attached.AttachTo(creature); err != nil {
+		t.Fatalf("AttachTo: %v", err)
+	}
+
+	obj := &StackObject{
+		Card:        source,
+		Controller:  0,
+		IsAbility:   true,
+		Text:        "destroy",
+		EffectValue: map[string]interface{}{"all": true, "filter": "equipment"},
+	}
+	if err := gs.ExecuteAbilityEffect(obj); err != nil {
+		t.Fatalf("ExecuteAbilityEffect(destroy all equipment): %v", err)
+	}
+
+	if _, err := gs.Battlefield.GetCard(unattached.ID); err == nil {
+		t.Fatalf("unattached equipment survived an unscoped 'destroy all Equipment'")
+	}
+	if _, err := gs.Battlefield.GetCard(attached.ID); err == nil {
+		t.Fatalf("attached equipment survived an unscoped 'destroy all Equipment'")
+	}
+}
