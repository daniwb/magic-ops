 // a "destroy" atom with effect_value.all inside a multi-atom spell sequence
 // — task-1876 round 2: "Destroy all creatures. Draw a card." class).
-func (gs *GameState) destroyAllMatching(caster int, filter, scope string, cantBeRegenerated bool, excludeID string, tokensOnly bool) error {
+func (gs *GameState) destroyAllMatching(caster int, filter, scope string, cantBeRegenerated bool, excludeID string, tokensOnly bool, attachedTo string) error {
 	filter = strings.ToLower(strings.TrimSpace(filter))
 	scope = strings.ToLower(strings.TrimSpace(scope))
 
@@ -4336,6 +4336,16 @@ func (gs *GameState) destroyAllMatching(caster int, filter, scope string, cantBe
 		if excludeID != "" && c.ID == excludeID {
 			continue
 		}
+		// destroy_attached_to_referent (ticket
+		// engine.auto-destroy-attached-to-referent-d32bfbcd7a, Turn to Slag
+		// class: "Destroy all Equipment attached to that creature."): when a
+		// referent card ID is supplied, the sweep is narrowed to permanents
+		// currently attached to it, on top of the ordinary filter/scope
+		// checks below. Empty attachedTo (the overwhelmingly common case)
+		// leaves the sweep unrestricted, matching every existing caller.
+		if attachedTo != "" && c.AttachedTo != attachedTo {
+			continue
+		}
 		if tokensOnly && !c.IsToken {
 			continue
 		}
