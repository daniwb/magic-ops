+package game
+
+import "testing"
+
+func TestFactoryNGExileTargetGraveyardCardAndNamedMatches(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	target := &Card{ID: "target", Name: "Relic", Type: CardType("Artifact")}
+	graveyardMatch := &Card{ID: "graveyard-match", Name: "Relic", Type: CardType("Artifact")}
+	permanentMatch := &Card{ID: "permanent-match", Name: "Relic", Type: CardType("Artifact")}
+
+	gs.Players[0].Graveyard.AddCard(target)
+	gs.Players[1].Graveyard.AddCard(graveyardMatch)
+	gs.Battlefield.AddCard(permanentMatch)
+
+	err := gs.ExecuteAbilityEffect(&StackObject{
+		IsAbility: true,
+		Text:      "exile_target_graveyard_card_and_named_matches",
+		Targets:   []Target{{IsCard: true, CardID: target.ID}},
+	})
+	if err != nil {
+		t.Fatalf("ExecuteAbilityEffect: %v", err)
+	}
+
+	if _, err := gs.Players[0].Graveyard.GetCard(target.ID); err == nil {
+		t.Fatal("target remained in its graveyard")
+	}
+	if _, err := gs.Players[1].Graveyard.GetCard(graveyardMatch.ID); err == nil {
+		t.Fatal("named graveyard match remained in a graveyard")
+	}
+	if _, err := gs.Battlefield.GetCard(permanentMatch.ID); err == nil {
+		t.Fatal("named permanent remained on the battlefield")
+	}
+	if _, err := gs.Players[0].Exile.GetCard(target.ID); err != nil {
+		t.Fatal("target was not exiled")
+	}
+	if _, err := gs.Players[1].Exile.GetCard(graveyardMatch.ID); err != nil {
+		t.Fatal("named graveyard match was not exiled")
+	}
+}
