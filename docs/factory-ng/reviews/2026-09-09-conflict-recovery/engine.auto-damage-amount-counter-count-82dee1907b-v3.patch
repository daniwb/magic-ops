@@ -0,0 +1,50 @@
+package game
+
+import "testing"
+
+// TestFactoryNGDamageAmountCounterCount covers the damage_amount_counter_count
+// primitive (ticket engine.auto-damage-amount-counter-count-82dee1907b,
+// Falkenrath Exterminator class): "~ deals damage to target creature equal
+// to the number of +1/+1 counters on this creature." Verifies the resolved
+// amount tracks the referenced permanent's counter count exactly — zero
+// counters is a no-op, a specific count produces that exact amount, and an
+// unrelated counter type on the same permanent is never conflated with it.
+func TestFactoryNGDamageAmountCounterCount(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+
+	src := NewCreature("Test Exterminator", ManaCost{}, 2, 2, 0)
+	src.Owner, src.Controller = 0, 0
+	gs.Battlefield.AddCard(src)
+
+	victim := NewCreature("Test Victim", ManaCost{}, 4, 4, 0)
+	victim.Owner, victim.Controller = 1, 1
+	gs.Battlefield.AddCard(victim)
+
+	target := Target{IsCard: true, CardID: victim.ID}
+
+	amount, err := gs.DealDamageEqualToCounterCount(src, 0, target, src, CounterType("+1/+1"))
+	if err != nil {
+		t.Fatalf("DealDamageEqualToCounterCount (no counters): %v", err)
+	}
+	if amount != 0 {
+		t.Fatalf("expected 0 amount with no +1/+1 counters, got %d", amount)
+	}
+
+	src.Counters.AddCounter(CounterType("+1/+1"), 3)
+
+	amount, err = gs.DealDamageEqualToCounterCount(src, 0, target, src, CounterType("+1/+1"))
+	if err != nil {
+		t.Fatalf("DealDamageEqualToCounterCount: %v", err)
+	}
+	if amount != 3 {
+		t.Fatalf("expected amount 3 matching +1/+1 counters on source, got %d", amount)
+	}
+
+	amount, err = gs.DealDamageEqualToCounterCount(src, 0, target, src, CounterType("charge"))
+	if err != nil {
+		t.Fatalf("DealDamageEqualToCounterCount (unrelated counter type): %v", err)
+	}
+	if amount != 0 {
+		t.Fatalf("expected 0 amount for unrelated counter type, got %d", amount)
+	}
+}
