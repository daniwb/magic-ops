@@ -0,0 +1,57 @@
+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGEachPlayerDiscardHandDynamicCount_6be50d10d1(t *testing.T) {
+	def := &CardDefinition{
+		Name:  "Wheel Without Draw",
+		Type:  "Instant",
+		Types: []string{"Instant"},
+		Abilities: []AbilityDSL{{
+			Type:   "spell",
+			Effect: "each_player_discard_hand",
+		}},
+		Status: StatusManual,
+	}
+
+	spell, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if spell.SpellEffect == nil || spell.SpellEffect.Type != "each_player_discard_hand" {
+		t.Fatalf("spell effect = %#v, want each_player_discard_hand", spell.SpellEffect)
+	}
+
+	gs := game.NewGame("P0", "P1", true)
+	gs.Players[0].Hand.AddCard(spell)
+	for i := 0; i < 2; i++ {
+		gs.Players[0].Hand.AddCard(game.NewCard("P0 Hand", game.CardType("Artifact"), game.ManaCost{}, 0))
+	}
+	for i := 0; i < 4; i++ {
+		gs.Players[1].Hand.AddCard(game.NewCard("P1 Hand", game.CardType("Artifact"), game.ManaCost{}, 1))
+	}
+
+	if err := gs.CastSpellWithTargets(0, spell.ID, nil); err != nil {
+		t.Fatalf("CastSpellWithTargets: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+
+	if got := gs.Players[0].Hand.Count(); got != 0 {
+		t.Fatalf("player 0 hand count = %d, want 0", got)
+	}
+	if got := gs.Players[1].Hand.Count(); got != 0 {
+		t.Fatalf("player 1 hand count = %d, want 0", got)
+	}
+	if got := gs.Players[0].Graveyard.Count(); got != 3 {
+		t.Fatalf("player 0 graveyard count = %d, want 3", got)
+	}
+	if got := gs.Players[1].Graveyard.Count(); got != 4 {
+		t.Fatalf("player 1 graveyard count = %d, want 4", got)
+	}
+}
