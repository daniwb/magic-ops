+def _put_counter_and_draw_atom(ch, kind=None):
+    if kind != 'triggered' or ' and ' not in ch:
+        return None
+    left, right = (part.strip() for part in ch.rstrip('.').split(' and ', 1))
+    if right != 'draw a card':
+        return None
+    pv, pt = O.parse_atom(left)
+    dv, dt = O.parse_atom(right)
+    if pv != 'put_counters' or dv != 'draw' or not pt or not dt:
+        return None
+    if _amt(dt.get('amount')) != 1:
+        return None
+    mapped = map_atom(pv, pt, kind=kind)
+    if mapped is None or mapped[0] != 'put_counters':
+        return None
+    target = mapped[2]
+    if target != {'filter': 'creature'}:
+        return None
+    return ('put_counter_and_draw_card', dict(mapped[1]), target)
+
