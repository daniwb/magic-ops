--- /dev/null
+++ b/backend/cards/factory_ng_7fda0f0882_test.go
@@ -0,0 +1,66 @@
+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGPutCountersOnCombatRelatedCreatures_7fda0f0882(t *testing.T) {
+	def := &CardDefinition{
+		Name: "Greater Werewolf",
+		Type: "Creature",
+		Types: []string{"Creature"},
+		Power: intPtr(2),
+		Toughness: intPtr(4),
+		Abilities: []AbilityDSL{{
+			Type:    "triggered",
+			Trigger: "blocks",
+			Effect:  "put_counters",
+			Value: map[string]interface{}{
+				"counter_type": "-0/-2",
+				"amount":       1,
+			},
+		}},
+	}
+
+	source, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	gs.Battlefield.AddCard(source)
+	gs.RegisterCardAbilities(source)
+
+	attacker := game.NewCreature("Attacker", game.ManaCost{}, 3, 3, 1)
+	gs.Battlefield.AddCard(attacker)
+
+	blocker := game.NewCreature("Blocker", game.ManaCost{}, 2, 2, 1)
+	blocker.Blocking = true
+	blocker.BlockingCardID = source.ID
+	gs.Battlefield.AddCard(blocker)
+
+	source.Blocking = true
+	source.BlockingCardID = attacker.ID
+
+	unrelated := game.NewCreature("Unrelated", game.ManaCost{}, 2, 2, 1)
+	gs.Battlefield.AddCard(unrelated)
+
+	gs.ProcessTriggeredAbilities(game.CreateBlocksEvent(source, attacker, source.Controller))
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+
+	gs.EventBus.Publish(game.NewEvent(game.EventEndOfCombat))
+
+	if got := blocker.Counters.Custom["-0/-2"]; got != 1 {
+		t.Fatalf("blocking creature counters = %d, want 1", got)
+	}
+	if got := attacker.Counters.Custom["-0/-2"]; got != 1 {
+		t.Fatalf("blocked creature counters = %d, want 1", got)
+	}
+	if got := unrelated.Counters.Custom["-0/-2"]; got != 0 {
+		t.Fatalf("unrelated creature counters = %d, want 0", got)
+	}
+}
