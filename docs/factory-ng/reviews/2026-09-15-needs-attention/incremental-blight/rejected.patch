index 0000000000000000000000000000000000000000..766019066f13ef62650b63e20a891b0f959deb4e
--- /dev/null
+++ b/backend/game/factory_ng_a8e4b194e3_test.go
@@ -0,0 +1,68 @@
+package game_test
+
+import (
+	"testing"
+
+	"magic-backend/cards"
+	"magic-backend/game"
+)
+
+func TestFactoryNGPutCountersIndependentMultiTargetSequence_a8e4b194e3(t *testing.T) {
+	def := &cards.CardDefinition{
+		Name:  "Incremental Blight",
+		Type:  "Instant",
+		Types: []string{"Instant"},
+		Abilities: []cards.AbilityDSL{{
+			Type: "spell",
+			Effects: []cards.EffectAtom{
+				{Effect: "put_counters", Value: map[string]interface{}{
+					"amount": 1, "counter_type": "-1/-1",
+				}, Target: &cards.TargetFilter{Filter: "creature", MinTargets: 1, MaxTargets: 1}},
+				{Effect: "put_counters", Value: map[string]interface{}{
+					"amount": 2, "counter_type": "-1/-1",
+				}, Target: &cards.TargetFilter{Filter: "creature", MinTargets: 1, MaxTargets: 1}},
+				{Effect: "put_counters", Value: map[string]interface{}{
+					"amount": 3, "counter_type": "-1/-1",
+				}, Target: &cards.TargetFilter{Filter: "creature", MinTargets: 1, MaxTargets: 1}},
+			},
+		}},
+	}
+
+	spell, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	one := game.NewCreature("One", game.ManaCost{}, 5, 5, 1)
+	two := game.NewCreature("Two", game.ManaCost{}, 5, 5, 1)
+	three := game.NewCreature("Three", game.ManaCost{}, 5, 5, 1)
+	gs.Battlefield.AddCard(one)
+	gs.Battlefield.AddCard(two)
+	gs.Battlefield.AddCard(three)
+	gs.Players[0].Hand.AddCard(spell)
+
+	targets := []game.Target{
+		{IsCard: true, CardID: one.ID},
+		{IsCard: true, CardID: two.ID},
+		{IsCard: true, CardID: three.ID},
+	}
+	if err := gs.CastSpellWithTargets(0, spell.ID, targets); err != nil {
+		t.Fatal(err)
+	}
+	for !gs.Stack.IsEmpty() {
+		if err := gs.ResolveTopOfStack(); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	if got := one.Counters.GetCount(game.CounterMinusOneMinusOne); got != 1 {
+		t.Fatalf("first target counters=%d, want 1", got)
+	}
+	if got := two.Counters.GetCount(game.CounterMinusOneMinusOne); got != 2 {
+		t.Fatalf("second target counters=%d, want 2", got)
+	}
+	if got := three.Counters.GetCount(game.CounterMinusOneMinusOne); got != 3 {
+		t.Fatalf("third target counters=%d, want 3", got)
+	}
+}
