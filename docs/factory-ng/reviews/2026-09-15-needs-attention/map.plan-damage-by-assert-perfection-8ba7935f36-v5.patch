diff --git a/scripts/paragraph/test_factory_ng_8ba7935f36.py b/scripts/paragraph/test_factory_ng_8ba7935f36.py
new file mode 100644
index 000000000..85b41ba32
--- /dev/null
+++ b/scripts/paragraph/test_factory_ng_8ba7935f36.py
@@ -0,0 +1,67 @@
+import unittest
+
+from reparse import load_card, map_atom, reparse_card
+
+
+class TestAssertPerfectionDamageBy(unittest.TestCase):
+    def test_assert_perfection_maps_complete_oracle(self):
+        result = reparse_card(load_card("Assert Perfection"))
+
+        self.assertTrue(result["eligible"], result["misses"])
+        self.assertEqual(result["misses"], [])
+        self.assertEqual(
+            result["abilities"],
+            [
+                {
+                    "type": "spell",
+                    "effects": [
+                        {
+                            "effect": "pump_until_eot",
+                            "value": {"power": 1, "toughness": 0},
+                            "target": {
+                                "controller": "you",
+                                "filter": "creature",
+                            },
+                        },
+                        {
+                            "effect": "damage",
+                            "value": {
+                                "amount_count": {"count": "sequence_referent"},
+                            },
+                            "target": {"filter": "creature_opp_ctrl"},
+                            "optional": True,
+                        },
+                    ],
+                }
+            ],
+        )
+
+    def test_independent_target_source_remains_unmapped(self):
+        self.assertIsNone(
+            map_atom(
+                "damage_by",
+                {
+                    "amount_expr": "its power",
+                    "raw_to": "up to one target creature an opponent controls",
+                    "src": {
+                        "object": {
+                            "controller": "you",
+                            "filter": "creature",
+                        }
+                    },
+                    "to": {
+                        "count": "one",
+                        "target": {
+                            "controller": "opponent",
+                            "filter": "creature",
+                        },
+                        "up_to": True,
+                    },
+                },
+                kind="spell_oneshot",
+            )
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
