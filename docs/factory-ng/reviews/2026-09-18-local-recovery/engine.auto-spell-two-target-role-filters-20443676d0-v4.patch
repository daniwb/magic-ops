+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGSpellTwoTargetRoleFilters_20443676d0(t *testing.T) {
+	def := &CardDefinition{
+		Name:  "Fall of the Hammer Shape",
+		Type:  "Instant",
+		Types: []string{"Instant"},
+		Abilities: []AbilityDSL{{
+			Type:    "spell",
+			Effect:  "damage_by",
+			Affects: &TargetFilter{Filter: "creature", Controller: "you"},
+			Target:  &TargetFilter{Filter: "creature"},
+		}},
+		Status: StatusManual,
+	}
+	spell, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if spell.SpellEffect == nil ||
+		spell.SpellEffect.SpellTargetType != game.TargetCreatureYouCtlAndCreatureSlots ||
+		spell.SpellEffect.MinTargets != 2 || spell.SpellEffect.MaxTargets != 2 {
+		t.Fatalf("two target roles were not preserved: %+v", spell.SpellEffect)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	source := game.NewCreature("Caster's Source", game.ManaCost{}, 3, 3, 0)
+	opponentSource := game.NewCreature("Opponent Source", game.ManaCost{}, 4, 4, 1)
+	recipient := game.NewCreature("Recipient", game.ManaCost{}, 1, 10, 1)
+	gs.Battlefield.AddCard(source)
+	gs.Battlefield.AddCard(opponentSource)
+	gs.Battlefield.AddCard(recipient)
+	gs.Players[0].Hand.AddCard(spell)
+
+	if err := gs.CastSpellWithTargets(0, spell.ID, []game.Target{
+		{Type: game.TargetCreatureYouCtl, IsCard: true, CardID: opponentSource.ID},
+		{Type: game.TargetCreature, IsCard: true, CardID: recipient.ID},
+	}); err == nil {
+		t.Fatal("opponent-controlled source was accepted")
+	}
+
+	if err := gs.CastSpellWithTargets(0, spell.ID, []game.Target{
+		{Type: game.TargetCreatureYouCtl, IsCard: true, CardID: source.ID},
+		{Type: game.TargetCreature, IsCard: true, CardID: recipient.ID},
+	}); err != nil {
+		t.Fatalf("CastSpellWithTargets: %v", err)
+	}
+
+	*source.BasePower = 5
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+	if recipient.Damage != 5 {
+		t.Fatalf("recipient damage = %d, want source's live power 5", recipient.Damage)
+	}
+	if source.Damage != 0 {
+		t.Fatalf("source took %d damage; effect must be one-way", source.Damage)
+	}
+}
