+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGDamageEqualToSourcePowerToFlyingCreature(t *testing.T) {
+	def := &CardDefinition{
+		Name:      "Factory Jagged-Scar Archers",
+		Type:      "Creature",
+		Types:     []string{"Creature"},
+		Power:     intPtr(3),
+		Toughness: intPtr(3),
+		Abilities: []AbilityDSL{{
+			Type:   "activated",
+			Effect: "damage_by_power",
+			Cost:   &AbilityCost{},
+			Target: &TargetFilter{Filter: "creature", Keyword: game.Flying},
+		}},
+		Status: StatusManual,
+	}
+	source, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if len(source.ActivatedAbilities) != 1 {
+		t.Fatalf("activated abilities = %d, want 1", len(source.ActivatedAbilities))
+	}
+	ability := source.ActivatedAbilities[0]
+	if ability.Effect != "damage" {
+		t.Fatalf("effect = %q, want damage", ability.Effect)
+	}
+	if ability.Target == nil || ability.Target.Type != "flying_creature" {
+		t.Fatalf("target filter = %#v, want flying_creature", ability.Target)
+	}
+	if count, ok := ability.EffectValue["amount_count"].(map[string]interface{}); !ok || count["count"] != "source_power" {
+		t.Fatalf("amount_count = %#v, want source_power", ability.EffectValue["amount_count"])
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	source.Owner, source.Controller = 0, 0
+	gs.Battlefield.AddCard(source)
+	gs.RegisterCardAbilities(source)
+
+	flyer := game.NewCreature("Factory Flyer", game.ManaCost{}, 1, 7, 1)
+	flyer.Keywords = append(flyer.Keywords, game.Flying)
+	gs.Battlefield.AddCard(flyer)
+
+	ground := game.NewCreature("Factory Ground Creature", game.ManaCost{}, 1, 7, 1)
+	gs.Battlefield.AddCard(ground)
+
+	requirement := game.TargetRequirement{Type: game.TargetType(ability.Target.Type)}
+	if !game.IsValidTarget(game.Target{IsCard: true, CardID: flyer.ID}, requirement, gs, 0) {
+		t.Fatal("flying creature was not a legal target")
+	}
+	if game.IsValidTarget(game.Target{IsCard: true, CardID: ground.ID}, requirement, gs, 0) {
+		t.Fatal("non-flying creature was accepted as a legal target")
+	}
+
+	if err := gs.ActivateAbility(0, source.ID, 0, []game.Target{{IsCard: true, CardID: flyer.ID}}); err != nil {
+		t.Fatalf("ActivateAbility: %v", err)
+	}
+	source.Counters.PlusOnePlusOne = 2
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+	if got, want := flyer.Damage, 5; got != want {
+		t.Fatalf("flying target damage = %d, want %d from source's current power", got, want)
+	}
+	if ground.Damage != 0 {
+		t.Fatalf("non-flying creature received damage: %d", ground.Damage)
+	}
+}
