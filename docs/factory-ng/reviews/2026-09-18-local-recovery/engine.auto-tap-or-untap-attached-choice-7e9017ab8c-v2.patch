+package cards
+
+func init() {
+	regEffect("tap_or_untap_attached_choice", Primitive{
+		Executor:  "game/ability_effects.go ExecuteAbilityEffect case tap_or_untap_attached_choice -> executeTapOrUntapAttachedChoice",
+		ShapeTest: "TestFactoryNGTapOrUntapAttachedChoice_7e9017ab8c",
+	})
+}
