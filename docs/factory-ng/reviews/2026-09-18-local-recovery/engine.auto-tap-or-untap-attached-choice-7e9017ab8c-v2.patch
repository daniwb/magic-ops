+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGTapOrUntapAttachedChoice_7e9017ab8c(t *testing.T) {
+	choiceDef := &CardDefinition{
+		Name:     "Factory Choice Equipment",
+		Type:     "Artifact",
+		Types:    []string{"Artifact"},
+		SubTypes: []string{"Equipment"},
+		Abilities: []AbilityDSL{{
+			Type:   "activated",
+			Effect: "tap_or_untap_attached_choice",
+			Cost:   &AbilityCost{},
+		}},
+		Status: StatusManual,
+	}
+	equipment, err := choiceDef.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard(choice): %v", err)
+	}
+
+	plainTapDef := &CardDefinition{
+		Name:     "Factory Plain Tap Equipment",
+		Type:     "Artifact",
+		Types:    []string{"Artifact"},
+		SubTypes: []string{"Equipment"},
+		Abilities: []AbilityDSL{{
+			Type:   "activated",
+			Effect: "tap",
+			Value:  map[string]interface{}{"target_attached": true},
+			Cost:   &AbilityCost{},
+		}},
+		Status: StatusManual,
+	}
+	plainTap, err := plainTapDef.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard(plain tap): %v", err)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	equipped := game.NewCreature("Equipped Creature", game.ManaCost{}, 2, 2, 0)
+	equipped.Owner, equipped.Controller = 0, 0
+	equipped.Tapped = true
+	other := game.NewCreature("Unattached Creature", game.ManaCost{}, 2, 2, 0)
+	other.Owner, other.Controller = 0, 0
+	gs.Battlefield.AddCard(equipped)
+	gs.Battlefield.AddCard(other)
+	gs.Battlefield.AddCard(equipment)
+	gs.Battlefield.AddCard(plainTap)
+	if err := equipment.AttachTo(equipped); err != nil {
+		t.Fatalf("attach choice equipment: %v", err)
+	}
+	if err := plainTap.AttachTo(equipped); err != nil {
+		t.Fatalf("attach plain-tap equipment: %v", err)
+	}
+	gs.RegisterCardAbilities(equipment)
+	gs.RegisterCardAbilities(plainTap)
+
+	if err := gs.ActivateAbility(0, equipment.ID, 0, nil); err != nil {
+		t.Fatalf("activate untap choice: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("resolve untap choice: %v", err)
+	}
+	if gs.PendingOptionChoice == nil {
+		t.Fatal("expected tap-or-untap choice at resolution")
+	}
+	if !equipped.Tapped {
+		t.Fatal("equipped creature changed before the controller chose an outcome")
+	}
+	if err := gs.ResolveOptionChoice(0, "untap"); err != nil {
+		t.Fatalf("choose untap: %v", err)
+	}
+	if equipped.Tapped {
+		t.Fatal("untap choice did not untap the equipped creature")
+	}
+	if other.Tapped {
+		t.Fatal("choice affected an unattached creature")
+	}
+
+	if err := gs.ActivateAbility(0, equipment.ID, 0, nil); err != nil {
+		t.Fatalf("activate tap choice: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("resolve tap choice: %v", err)
+	}
+	if err := gs.ResolveOptionChoice(0, "tap"); err != nil {
+		t.Fatalf("choose tap: %v", err)
+	}
+	if !equipped.Tapped {
+		t.Fatal("tap choice did not tap the equipped creature")
+	}
+
+	equipped.Untap()
+	if err := gs.ActivateAbility(0, plainTap.ID, 0, nil); err != nil {
+		t.Fatalf("activate plain attached tap: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("resolve plain attached tap: %v", err)
+	}
+	if !equipped.Tapped {
+		t.Fatal("plain attached tap no longer directly tapped the equipped creature")
+	}
+	if gs.PendingOptionChoice != nil {
+		t.Fatal("plain attached tap incorrectly opened a tap-or-untap choice")
+	}
+}
