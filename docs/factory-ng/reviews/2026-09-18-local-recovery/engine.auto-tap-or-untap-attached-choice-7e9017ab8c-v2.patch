@@ -20516,6 +20518,25 @@ func (gs *GameState) executeTapAllEffect(controller int, source *Card, effectVal
 	return nil
 }
 
+// executeTapOrUntapAttachedChoice implements "You may tap or untap equipped
+// creature." The attached permanent is determined as the Equipment ability
+// resolves, then its controller chooses the tap-state outcome.
+func (gs *GameState) executeTapOrUntapAttachedChoice(controller int, source *Card) error {
+	if source == nil {
+		return nil
+	}
+	target := source.GetAttachedCard(gs.Battlefield)
+	if target == nil {
+		return nil
+	}
+	targetID := target.ID
+	gs.StartOptionChoice(controller, []string{"tap", "untap"}, source.Name,
+		func(gs *GameState, chosen string) {
+			gs.applyTapOrUntapToCardIDs([]string{targetID}, chosen)
+		})
+	return nil
+}
+
 // executeUntapEffect - "Untap target permanent" or the permanent attached to
 // source when target_attached is set and no target was chosen.
 func (gs *GameState) executeRemoveFromCombatAndUntapEffect(source *Card, targets []Target) error {
