+func (gs *GameState) executeDamagePunisherChoiceEffect(controller int, source *Card, effectValue map[string]interface{}, targets []Target) error {
+	if len(targets) == 0 || !targets[0].IsCard {
+		return nil
+	}
+	target, err := gs.Battlefield.GetCard(targets[0].CardID)
+	if err != nil || target == nil || !target.IsCreature() {
+		return nil
+	}
+	chooser := target.Controller
+	if chooser < 0 || chooser >= len(gs.Players) {
+		return nil
+	}
+	creatureAmount := getIntValue(effectValue, "amount", 0)
+	controllerAmount := getIntValue(effectValue, "controller_amount", 0)
+	targetID := target.ID
+	sourceName := ""
+	if source != nil {
+		sourceName = source.Name
+	}
+	gs.StartOptionChoice(chooser, []string{"creature", "controller"}, sourceName, func(gs *GameState, chosen string) {
+		if chosen == "controller" {
+			_ = gs.executeDamageEffect(controller, source,
+				map[string]interface{}{"amount": controllerAmount},
+				[]Target{{PlayerIdx: chooser}})
+			return
+		}
+		_ = gs.executeDamageEffect(controller, source,
+			map[string]interface{}{"amount": creatureAmount},
+			[]Target{{IsCard: true, CardID: targetID}})
+	})
+	return nil
+}
