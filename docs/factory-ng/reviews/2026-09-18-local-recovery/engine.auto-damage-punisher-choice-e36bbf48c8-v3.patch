+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGDamagePunisherChoice(t *testing.T) {
+	run := func(t *testing.T, choice string) (*game.GameState, *game.Card) {
+		t.Helper()
+
+		gs, source := shapeCard(t, []AbilityDSL{{
+			Type: "activated",
+			Effect: "damage_punisher_choice",
+			Cost: &AbilityCost{},
+			Value: map[string]interface{}{
+				"amount":            1,
+				"controller_amount": 2,
+			},
+			Target: &TargetFilter{Filter: "creature"},
+		}})
+
+		target := game.NewCreature("Target", game.ManaCost{}, 3, 3, 1)
+		target.Owner, target.Controller = 1, 1
+		gs.Battlefield.AddCard(target)
+
+		if err := gs.ActivateAbility(0, source.ID, 0, []game.Target{{
+			Type:    game.TargetCreature,
+			CardID:  target.ID,
+			IsCard:  true,
+		}}); err != nil {
+			t.Fatalf("ActivateAbility: %v", err)
+		}
+		if err := gs.ResolveTopOfStack(); err != nil {
+			t.Fatalf("ResolveTopOfStack: %v", err)
+		}
+		if gs.PendingOptionChoice == nil || gs.PendingOptionChoice.PlayerIdx != 1 {
+			t.Fatalf("expected target controller choice, got %#v", gs.PendingOptionChoice)
+		}
+		if err := gs.ResolveOptionChoice(1, choice); err != nil {
+			t.Fatalf("ResolveOptionChoice: %v", err)
+		}
+		return gs, target
+	}
+
+	gs, target := run(t, "creature")
+	if target.Damage != 1 || gs.Players[1].Life != 20 {
+		t.Fatalf("creature choice: damage=%d, controller life=%d", target.Damage, gs.Players[1].Life)
+	}
+
+	gs, target = run(t, "controller")
+	if target.Damage != 0 || gs.Players[1].Life != 18 {
+		t.Fatalf("controller choice: damage=%d, controller life=%d", target.Damage, gs.Players[1].Life)
+	}
+}
