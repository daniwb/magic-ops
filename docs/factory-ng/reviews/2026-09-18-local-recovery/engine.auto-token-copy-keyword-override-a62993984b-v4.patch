@@ -0,0 +1,102 @@
+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+// CAPABILITY_ASSESSMENT: {"classification":"connection","existing_symbols":["cards.CardDefinition.buildMainSpellEffect","game.GameState.applySpellEffectCore"],"remaining_gap":"token-copy spell conversion and resolution lost the nonlegendary exception and canonical keyword form","verification":"public converter, cast, stack, and resolution path"}
+func TestFactoryNGTokenCopyKeywordOverride_a62993984b(t *testing.T) {
+	makeSpell := func(name string, value map[string]interface{}) *game.Card {
+		t.Helper()
+		def := &CardDefinition{
+			Name:  name,
+			Type:  "Sorcery",
+			Types: []string{"Sorcery"},
+			Abilities: []AbilityDSL{{
+				Type:   "spell",
+				Effect: "token_copy",
+				Target: &TargetFilter{Filter: "creature", Controller: "you"},
+				Value:  value,
+			}},
+			Status: StatusManual,
+		}
+		spell, err := def.ToGameCard(0)
+		if err != nil {
+			t.Fatalf("ToGameCard: %v", err)
+		}
+		return spell
+	}
+
+	resolveCopy := func(t *testing.T, gs *game.GameState, spell, target *game.Card) {
+		t.Helper()
+		gs.Players[0].Hand.AddCard(spell)
+		if err := gs.CastSpellWithTargets(0, spell.ID, []game.Target{{IsCard: true, CardID: target.ID}}); err != nil {
+			t.Fatalf("CastSpellWithTargets: %v", err)
+		}
+		if err := gs.ResolveTopOfStack(); err != nil {
+			t.Fatalf("ResolveTopOfStack: %v", err)
+		}
+	}
+
+	t.Run("permanent flying composes with nonlegendary exception", func(t *testing.T) {
+		gs := game.NewGame("P0", "P1", false)
+		gs.PhaseManager.CurrentPhase = game.Phase{Type: game.PhaseMain1, Step: game.StepMain}
+		gs.PrioritySystem.SetActivePlayer(0)
+		gs.PrioritySystem.GivePriority(0)
+
+		target := game.NewCreature("Factory Legendary Hasty Wizard", game.ManaCost{}, 3, 4, 0)
+		target.SubTypes = []string{"Legendary", "Wizard"}
+		target.Colors = []game.Color{game.Blue}
+		target.Keywords = []game.Keyword{game.Haste}
+		gs.Battlefield.AddCard(target)
+
+		resolveCopy(t, gs, makeSpell("Factory Vile Duplication", map[string]interface{}{
+			"keywords":        []interface{}{"flying"},
+			"strip_legendary": true,
+		}), target)
+
+		var token *game.Card
+		for _, card := range gs.Battlefield.GetAll() {
+			if card.IsToken && card.Name == target.Name {
+				token = card
+				break
+			}
+		}
+		if token == nil {
+			t.Fatal("token_copy did not create a token")
+		}
+		if !token.HasKeyword(game.Flying) || !token.HasKeyword(game.Haste) {
+			t.Fatalf("token keywords = %v, want preserved haste plus permanent flying", token.Keywords)
+		}
+		if token.HasSubType("Legendary") || !token.HasSubType("Wizard") {
+			t.Fatalf("token subtypes = %v, want Wizard without Legendary", token.SubTypes)
+		}
+		if token.GetPower() != 3 || token.GetToughness() != 4 || len(token.Colors) != 1 || token.Colors[0] != game.Blue {
+			t.Fatalf("token characteristics were not preserved: %#v", token)
+		}
+
+		gs.CleanupEndOfTurnEffects()
+		if !token.HasKeyword(game.Flying) {
+			t.Fatal("token-copy flying exception expired at end of turn")
+		}
+	})
+
+	t.Run("ordinary copy has no keyword exception", func(t *testing.T) {
+		gs := game.NewGame("P0", "P1", false)
+		gs.PhaseManager.CurrentPhase = game.Phase{Type: game.PhaseMain1, Step: game.StepMain}
+		gs.PrioritySystem.SetActivePlayer(0)
+		gs.PrioritySystem.GivePriority(0)
+
+		target := game.NewCreature("Factory Grounded Copy Source", game.ManaCost{}, 2, 2, 0)
+		gs.Battlefield.AddCard(target)
+		resolveCopy(t, gs, makeSpell("Factory Plain Duplication", nil), target)
+
+		for _, card := range gs.Battlefield.GetAll() {
+			if card.IsToken && card.Name == target.Name && card.HasKeyword(game.Flying) {
+				t.Fatal("ordinary token_copy unexpectedly gained flying")
+			}
+		}
+	})
+}
