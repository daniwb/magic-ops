+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+// CAPABILITY_ASSESSMENT: {"classification":"connection","existing_symbols":["game.GameState.ExecuteAbilityEffect#case:fight"],"remaining_gap":"the converter did not preserve an enchanted-creature fight referent for v2 trigger atoms","verification":"public converter, trigger, target-choice, and resolution path"}
+func TestFactoryNGFightAttachedCreature_8575a14e03(t *testing.T) {
+	def := &CardDefinition{
+		Name:     "Warbriar Blessing",
+		Type:     "Enchantment — Aura",
+		Types:    []string{"Enchantment"},
+		SubTypes: []string{"Aura"},
+		Abilities: []AbilityDSL{{
+			Type:    "triggered",
+			Trigger: "etb",
+			Effects: []EffectAtom{{
+				Effect:  "fight",
+				Affects: &TargetFilter{Filter: "enchanted"},
+				Target:  &TargetFilter{Filter: "creature", Controller: "opponent"},
+			}},
+		}},
+		Status: StatusManual,
+	}
+	aura, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if !aura.IsAura() {
+		t.Fatal("converted Enchantment — Aura is not an Aura")
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	enchanted := game.NewCreature("Enchanted Fighter", game.ManaCost{}, 4, 6, 0)
+	enchanted.Counters.PlusOnePlusOne = 1
+	target := game.NewCreature("Opponent Target", game.ManaCost{}, 3, 6, 1)
+	gs.Battlefield.AddCard(enchanted)
+	gs.Battlefield.AddCard(target)
+	gs.Battlefield.AddCard(aura)
+	if err := aura.AttachTo(enchanted); err != nil {
+		t.Fatalf("AttachTo: %v", err)
+	}
+	gs.RegisterCardAbilities(aura)
+
+	gs.ProcessTriggeredAbilities(game.CreateETBEvent(aura, 0))
+	if gs.PendingTriggerTarget == nil {
+		t.Fatal("Aura fight trigger did not request its opponent creature target")
+	}
+	if err := gs.ResolveTriggerTargetChoice(0, target.ID); err != nil {
+		t.Fatalf("ResolveTriggerTargetChoice: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+
+	if got := enchanted.Damage; got != 3 {
+		t.Fatalf("enchanted creature damage = %d, want 3", got)
+	}
+	if got := target.Damage; got != 5 {
+		t.Fatalf("target damage = %d, want enchanted creature's live power 5", got)
+	}
+	if aura.Damage != 0 {
+		t.Fatalf("Aura incorrectly participated in fight with %d damage", aura.Damage)
+	}
+}
