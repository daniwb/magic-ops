@@ -0,0 +1,71 @@
+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGDamageByTargetSourcePowerMapping_024a5245b3(t *testing.T) {
+	def := &CardDefinition{
+		Name:  "Factory Gravitic Punch",
+		Type:  "Instant",
+		Types: []string{"Instant"},
+		Abilities: []AbilityDSL{{
+			Type: "spell",
+			Effects: []EffectAtom{{
+				Effect:  "damage_by",
+				Affects: &TargetFilter{Filter: "creature", Controller: "you"},
+				Target:  &TargetFilter{Filter: "player"},
+			}},
+		}},
+		Status: StatusManual,
+	}
+	spell, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if len(spell.SpellEffectSequence) != 1 || spell.SpellEffectSequence[0].Effect != "damage_by_target_source_power" {
+		t.Fatalf("converter did not preserve damage-by source mapping: %#v", spell.SpellEffectSequence)
+	}
+	if spell.SpellEffect == nil || spell.SpellEffect.SpellTargetType != game.TargetCreatureYouCtlAndPlayerSlots {
+		t.Fatalf("converter did not expose independent source/player target slots: %#v", spell.SpellEffect)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	source := game.NewCreature("Controlled Source", game.ManaCost{}, 4, 4, 0)
+	source.Owner, source.Controller = 0, 0
+	other := game.NewCreature("Opponent Source", game.ManaCost{}, 9, 9, 1)
+	other.Owner, other.Controller = 1, 1
+	gs.Battlefield.AddCard(source)
+	gs.Battlefield.AddCard(other)
+	gs.Players[0].Hand.AddCard(spell)
+
+	targets := []game.Target{
+		{Type: game.TargetCreatureYouCtl, CardID: source.ID, IsCard: true},
+		{Type: game.TargetPlayer, PlayerIdx: 1},
+	}
+	if err := gs.CastSpellWithTargets(0, spell.ID, []game.Target{
+		{Type: game.TargetCreatureYouCtl, CardID: other.ID, IsCard: true},
+		{Type: game.TargetPlayer, PlayerIdx: 1},
+	}); err == nil {
+		t.Fatal("cast accepted an opponent-controlled source creature")
+	}
+	if err := gs.CastSpellWithTargets(0, spell.ID, targets); err != nil {
+		t.Fatalf("CastSpellWithTargets: %v", err)
+	}
+
+	*source.BasePower = 7
+	life := gs.Players[1].Life
+	for !gs.Stack.IsEmpty() {
+		if err := gs.ResolveTopOfStack(); err != nil {
+			t.Fatalf("ResolveTopOfStack: %v", err)
+		}
+	}
+	if got, want := gs.Players[1].Life, life-7; got != want {
+		t.Fatalf("target player life = %d, want %d from source live power", got, want)
+	}
+	if source.Damage != 0 {
+		t.Fatalf("source creature took %d damage; effect must be one-way rather than fight", source.Damage)
+	}
+}
