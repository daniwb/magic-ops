diff --git a/backend/game/gamestate.go b/backend/game/gamestate.go
index 7fa1c6595..94a1ae59d 100644
--- a/backend/game/gamestate.go
+++ b/backend/game/gamestate.go
@@ -7160,6 +7160,16 @@ func (gs *GameState) DeclareAttackers(playerIdx int, attackerIDs []string) error
 		gs.Players[playerIdx].AttackedThisTurn = true
 	}
 	defendingPlayerIdx := 1 - playerIdx
+	triggerOncePerAttackDeclaration := func(ability *TriggeredAbility) bool {
+		for _, atom := range ability.EffectSequence {
+			if once, _ := atom.EffectValue["trigger_once_per_attack_declaration"].(bool); once {
+				return true
+			}
+		}
+		return false
+	}
+	groupAbilities := []*TriggeredAbility{}
+	groupEvents := map[*TriggeredAbility]*Event{}
 	for _, attacker := range attackers {
 		err := DeclareAttacker(attacker, gs.CombatState)
 		if err != nil {
@@ -7175,8 +7185,16 @@ func (gs *GameState) DeclareAttackers(playerIdx int, attackerIDs []string) error
 
 		// Fire "attacks" event for each attacker (Rule 508.1)
 		if gs.EventBus != nil {
-			triggered := gs.EventBus.Publish(CreateAttacksEvent(attacker, playerIdx, defendingPlayerIdx))
+			event := CreateAttacksEvent(attacker, playerIdx, defendingPlayerIdx)
+			triggered := gs.EventBus.Publish(event)
 			for _, ability := range triggered {
+				if triggerOncePerAttackDeclaration(ability) {
+					if _, seen := groupEvents[ability]; !seen {
+						groupAbilities = append(groupAbilities, ability)
+						groupEvents[ability] = event
+					}
+					continue
+				}
 				gs.PutTriggeredAbilityOnStack(ability)
 			}
 
@@ -7191,6 +7209,11 @@ func (gs *GameState) DeclareAttackers(playerIdx int, attackerIDs []string) error
 		}
 	}
 
+	// Reuse the matching events; publishing again would fire legacy handlers twice.
+	for _, ability := range groupAbilities {
+		gs.PutTriggeredAbilityOnStackWithEvent(ability, groupEvents[ability])
+	}
+
 	// Mark attackers as declared
 	gs.CombatState.AttackersDeclared = true
 
