index 000000000..4eaf3cbff
--- /dev/null
+++ b/backend/cards/factory_ng_d7ae562dbc_test.go
@@ -0,0 +1,77 @@
+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGDamageAmountEqualsTriggerCreatureCount(t *testing.T) {
+	def := &CardDefinition{
+		Name:  "Factory Lightmine Field",
+		Type:  "Enchantment",
+		Types: []string{"Enchantment"},
+		Abilities: []AbilityDSL{{
+			Type: "triggered",
+			TriggerV2: &TriggerSpec{
+				Event:    "attacks",
+				Subject:  &TargetFilter{Filter: "creature", Controller: "opponent"},
+				Modifier: "one_or_more",
+			},
+			Effects: []EffectAtom{{
+				Effect:  "damage",
+				Affects: &TargetFilter{Filter: "creature", Attacking: true},
+				Value: map[string]interface{}{
+					"amount_count": map[string]interface{}{
+						"count":     "battlefield",
+						"filter":    "creature",
+						"attacking": true,
+					},
+				},
+			}},
+		}},
+		Status: StatusManual,
+	}
+
+	source, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	gs.Battlefield.AddCard(source)
+	gs.RegisterCardAbilities(source)
+
+	attackerA := game.NewCreature("Factory Attacker A", game.ManaCost{}, 3, 3, 1)
+	attackerB := game.NewCreature("Factory Attacker B", game.ManaCost{}, 3, 3, 1)
+	bystander := game.NewCreature("Factory Bystander", game.ManaCost{}, 3, 3, 1)
+	for _, card := range []*game.Card{attackerA, attackerB, bystander} {
+		card.Owner, card.Controller = 1, 1
+		card.SummoningSick = false
+		gs.Battlefield.AddCard(card)
+	}
+
+	gs.ActivePlayerIdx = 1
+	gs.PhaseManager.CurrentPhase = game.Phase{Type: game.PhaseCombat, Step: game.StepDeclareAttackers}
+	if err := gs.DeclareAttackers(1, []string{attackerA.ID, attackerB.ID}); err != nil {
+		t.Fatalf("DeclareAttackers: %v", err)
+	}
+	if gs.Stack.IsEmpty() {
+		t.Fatal("one-or-more attack trigger did not reach the stack")
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+
+	for _, attacker := range []*game.Card{attackerA, attackerB} {
+		if attacker.Damage != 2 {
+			t.Fatalf("%s marked damage = %d, want 2 for the two attacking creatures", attacker.Name, attacker.Damage)
+		}
+	}
+	if bystander.Damage != 0 {
+		t.Fatalf("nonattacking creature marked damage = %d, want 0", bystander.Damage)
+	}
+	if !gs.Stack.IsEmpty() {
+		t.Fatal("one-or-more attack trigger was placed on the stack more than once")
+	}
+}
