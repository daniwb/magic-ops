+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+// CAPABILITY_ASSESSMENT: {"classification":"connection","existing_symbols":["cards.AbilityToTriggered","game.GameState.ExecuteAbilityEffect#case:fight"],"remaining_gap":"Aura-triggered fight atoms did not mark their attached creature as the first combatant","verification":"public converter/trigger/resolution-path test"}
+func TestFactoryNGFightAttachedReferent_1622bc7a24(t *testing.T) {
+	def := &CardDefinition{
+		Name:     "Factory Pitiless Fists",
+		Type:     "Enchantment",
+		Types:    []string{"Enchantment"},
+		SubTypes: []string{"Aura"},
+		Abilities: []AbilityDSL{
+			{
+				Type:   "static",
+				Effect: "enchant_target",
+				Value:  map[string]interface{}{"target": "creature you control"},
+			},
+			{
+				Type:      "triggered",
+				TriggerV2: &TriggerSpec{Event: "etb"},
+				Effects: []EffectAtom{{
+					Effect:   "fight",
+					Optional: true,
+					Target: &TargetFilter{
+						Filter:     "creature",
+						Controller: "opponent",
+					},
+				}},
+			},
+		},
+		Status: StatusManual,
+	}
+
+	aura, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if len(aura.TriggeredAbilities) != 1 ||
+		len(aura.TriggeredAbilities[0].EffectSequence) != 1 ||
+		!aura.TriggeredAbilities[0].EffectSequence[0].Optional ||
+		!aura.TriggeredAbilities[0].EffectSequence[0].EffectValue["fight_attached_referent"].(bool) {
+		t.Fatalf("attached optional fight was not converted: %+v", aura.TriggeredAbilities)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	enchanted := game.NewCreature("Enchanted Fighter", game.ManaCost{}, 4, 6, 0)
+	enchanted.Owner, enchanted.Controller = 0, 0
+	opponent := game.NewCreature("Opponent Fighter", game.ManaCost{}, 3, 7, 1)
+	opponent.Owner, opponent.Controller = 1, 1
+	gs.Battlefield.AddCard(enchanted)
+	gs.Battlefield.AddCard(opponent)
+	gs.Battlefield.AddCard(aura)
+
+	if err := gs.AttachAura(0, aura.ID, enchanted.ID, ""); err != nil {
+		t.Fatalf("AttachAura: %v", err)
+	}
+	gs.RegisterCardAbilities(aura)
+	gs.ProcessTriggeredAbilities(game.CreateETBEvent(aura, 0))
+
+	if gs.PendingTriggerTarget == nil {
+		t.Fatal("expected opposing-creature target choice")
+	}
+	if err := gs.ResolveTriggerTargetChoice(0, opponent.ID); err != nil {
+		t.Fatalf("ResolveTriggerTargetChoice: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+	if gs.PendingSequenceChoice == nil {
+		t.Fatal("expected optional fight choice")
+	}
+	if err := gs.ResolveSequenceChoice(0, true); err != nil {
+		t.Fatalf("ResolveSequenceChoice: %v", err)
+	}
+
+	if opponent.Damage != 4 {
+		t.Fatalf("opponent damage = %d, want enchanted creature power 4", opponent.Damage)
+	}
+	if enchanted.Damage != 3 {
+		t.Fatalf("enchanted creature damage = %d, want opponent power 3", enchanted.Damage)
+	}
+}
