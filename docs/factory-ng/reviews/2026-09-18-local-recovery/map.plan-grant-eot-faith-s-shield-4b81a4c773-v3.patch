@@ -0,0 +1,53 @@
+import unittest
+
+from reparse import load_card, reparse_card
+
+
+class TestFaithsShieldFatefulHour(unittest.TestCase):
+    def test_faiths_shield_maps_complete_fateful_hour_replacement(self):
+        card = load_card("Faith's Shield")
+        self.assertIsNotNone(card)
+
+        result = reparse_card(card)
+
+        self.assertTrue(result["eligible"], result)
+        self.assertEqual([], result["misses"])
+        self.assertEqual(
+            [{
+                "type": "spell",
+                "effects": [{
+                    "effect": (
+                        "conditional_chosen_color_protection_controller_and_"
+                        "permanents_eot"
+                    ),
+                    "target": {"filter": "permanent", "controller": "you"},
+                }],
+            }],
+            result["abilities"],
+        )
+
+    def test_adjacent_life_threshold_remains_unmapped(self):
+        result = reparse_card({
+            "name": "Adjacent Shield",
+            "types": ["Instant"],
+            "text": (
+                "Target permanent you control gains protection from the color "
+                "of your choice until end of turn.\n"
+                "Fateful hour — If you have 4 or less life, instead you and "
+                "each permanent you control gain protection from the color of "
+                "your choice until end of turn."
+            ),
+        })
+
+        self.assertFalse(result["eligible"], result)
+        self.assertTrue(result["misses"], result)
+        self.assertNotIn(
+            "conditional_chosen_color_protection_controller_and_permanents_eot",
+            [effect["effect"]
+             for ability in result["abilities"]
+             for effect in ability.get("effects", [])],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
