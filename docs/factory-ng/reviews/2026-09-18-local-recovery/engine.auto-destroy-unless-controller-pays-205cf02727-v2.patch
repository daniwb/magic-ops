 			if topObj.UnlessPayPlayerIdx != nil {
 				payerIdx = *topObj.UnlessPayPlayerIdx
 			}
+			if topObj.Text == "destroy" && topObj.EffectValue["unless_pay_target_controller"] == true &&
+				topObj.UnlessPayPlayerIdx == nil && len(topObj.Targets) > 0 {
+				target := topObj.Targets[0]
+				if target.IsCard && target.CardID != "" {
+					if card, err := gs.Battlefield.GetCard(target.CardID); err == nil &&
+						card.Controller >= 0 && card.Controller < len(gs.Players) {
+						payerIdx = card.Controller
+					}
+				}
+			}
 			gs.PendingMayPayMana = &PendingMayPayMana{
 				PlayerIdx:   payerIdx,
 				Mana:        topObj.UnlessPayMana,
