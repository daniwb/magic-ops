+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGDestroyUnlessControllerPays(t *testing.T) {
+	gs := game.NewGame("source", "target", false)
+
+	source := game.NewCreature("Plague Fiend", game.ManaCost{}, 3, 3, 0)
+	source.Owner, source.Controller = 0, 0
+	gs.Battlefield.AddCard(source)
+
+	target := game.NewCreature("Target Creature", game.ManaCost{}, 2, 2, 1)
+	target.Owner, target.Controller = 1, 1
+	gs.Battlefield.AddCard(target)
+
+	ability := AbilityToTriggered(AbilityDSL{
+		Type:   "triggered",
+		Effect: "destroy",
+		Value:  map[string]interface{}{"unless_pay_mana": "{2}"},
+	}, source, 0)
+
+	gs.Stack.PushTriggeredAbilityFull(ability)
+	gs.Stack.Peek().Targets = []game.Target{{IsCard: true, CardID: target.ID}}
+
+	gs.Players[1].ManaPool.Add(game.Colorless, 2)
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("resolve: %v", err)
+	}
+	if gs.PendingMayPayMana == nil || gs.PendingMayPayMana.PlayerIdx != 1 {
+		t.Fatalf("expected target controller to receive the payment choice: %+v", gs.PendingMayPayMana)
+	}
+	if err := gs.ResolveMayPayManaChoice(1, true); err != nil {
+		t.Fatalf("pay choice: %v", err)
+	}
+	if _, err := gs.Battlefield.GetCard(target.ID); err != nil {
+		t.Fatalf("target was destroyed despite controller paying: %v", err)
+	}
+
+	target2 := game.NewCreature("Target Creature 2", game.ManaCost{}, 2, 2, 1)
+	target2.Owner, target2.Controller = 1, 1
+	gs.Battlefield.AddCard(target2)
+
+	ability = AbilityToTriggered(AbilityDSL{
+		Type:   "triggered",
+		Effect: "destroy",
+		Value:  map[string]interface{}{"unless_pay_mana": "{2}"},
+	}, source, 1)
+	gs.Stack.PushTriggeredAbilityFull(ability)
+	gs.Stack.Peek().Targets = []game.Target{{IsCard: true, CardID: target2.ID}}
+
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("resolve decline case: %v", err)
+	}
+	if err := gs.ResolveMayPayManaChoice(1, false); err != nil {
+		t.Fatalf("decline choice: %v", err)
+	}
+	if _, err := gs.Battlefield.GetCard(target2.ID); err == nil {
+		t.Fatal("target survived after its controller declined to pay")
+	}
+}
