+package cards
+
+import (
+	"testing"
+
+	"magic-backend/game"
+)
+
+func TestFactoryNGReturnFromGraveyardMultiTargetAmount(t *testing.T) {
+	def := &CardDefinition{
+		Name:   "Factory Pull Through the Weft",
+		Type:   "Instant",
+		Types:  []string{"Instant"},
+		Status: StatusManual,
+		Abilities: []AbilityDSL{{
+			Type: "spell",
+			Effects: []EffectAtom{{
+				Effect: "return_from_graveyard",
+				Value: map[string]interface{}{
+					"card_type":   "land",
+					"count":       2,
+					"destination": "battlefield",
+					"tapped":      true,
+				},
+				Target: &TargetFilter{
+					Filter: "land",
+					Zone:   "graveyard",
+				},
+			}},
+		}},
+	}
+	spell, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatalf("ToGameCard: %v", err)
+	}
+	if len(spell.SpellEffectSequence) != 1 {
+		t.Fatalf("SpellEffectSequence length = %d, want 1", len(spell.SpellEffectSequence))
+	}
+	if got := spell.SpellEffectSequence[0].EffectValue["amount"]; got != 2 {
+		t.Fatalf("converted amount = %v, want 2", got)
+	}
+
+	gs := game.NewGame("P0", "P1", false)
+	landA := game.NewLand("Factory Weft Forest", "Forest", 0)
+	landA.Owner, landA.Controller = 0, 0
+	landB := game.NewLand("Factory Weft Island", "Island", 0)
+	landB.Owner, landB.Controller = 0, 0
+	untargeted := game.NewLand("Factory Weft Plains", "Plains", 0)
+	untargeted.Owner, untargeted.Controller = 0, 0
+	nonland := game.NewCreature("Factory Weft Creature", game.ManaCost{}, 1, 1, 0)
+	nonland.Owner, nonland.Controller = 0, 0
+	gs.Players[0].Graveyard.AddCard(landA)
+	gs.Players[0].Graveyard.AddCard(landB)
+	gs.Players[0].Graveyard.AddCard(untargeted)
+	gs.Players[0].Graveyard.AddCard(nonland)
+	gs.Players[0].Hand.AddCard(spell)
+
+	targets := []game.Target{
+		{IsCard: true, CardID: landA.ID, PlayerIdx: 0},
+		{IsCard: true, CardID: landB.ID, PlayerIdx: 0},
+	}
+	if err := gs.CastSpellWithTargets(0, spell.ID, targets); err != nil {
+		t.Fatalf("CastSpellWithTargets: %v", err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatalf("ResolveTopOfStack: %v", err)
+	}
+
+	for _, land := range []*game.Card{landA, landB} {
+		battlefieldLand, err := gs.Battlefield.GetCard(land.ID)
+		if err != nil {
+			t.Fatalf("%s was not returned: %v", land.Name, err)
+		}
+		if !battlefieldLand.Tapped {
+			t.Fatalf("%s entered untapped", land.Name)
+		}
+	}
+	if _, err := gs.Players[0].Graveyard.GetCard(untargeted.ID); err != nil {
+		t.Fatalf("untargeted land left graveyard: %v", err)
+	}
+	if _, err := gs.Players[0].Graveyard.GetCard(nonland.ID); err != nil {
+		t.Fatalf("nonland card left graveyard: %v", err)
+	}
+}
