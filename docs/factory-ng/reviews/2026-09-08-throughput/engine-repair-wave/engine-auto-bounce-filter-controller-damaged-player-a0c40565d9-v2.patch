--- /dev/null
+++ b/backend/cards/shape_audited_player_damage_test.go
@@ -0,0 +1,40 @@
+package cards
+
+import (
+	"magic-backend/game"
+	"testing"
+)
+
+func TestShape_AuditedPlayerDamageDSL(t *testing.T) {
+	gs := game.NewGame("P0", "P1", false)
+	dealer := game.NewCreature("dealer", game.ManaCost{}, 2, 2, 0)
+	gs.Battlefield.AddCard(dealer)
+	victim := game.NewCreature("victim", game.ManaCost{}, 2, 2, 1)
+	gs.Battlefield.AddCard(victim)
+	def := &CardDefinition{Name: "aura", Type: "Enchantment", Abilities: []AbilityDSL{{Type: "triggered", TriggerV2: &TriggerSpec{Event: "player_damaged", Subject: &TargetFilter{Filter: "enchanted"}}, Effects: []EffectAtom{{Effect: "bounce", Target: &TargetFilter{Filter: "creature", Controller: "defending_player"}}}}}}
+	aura, err := def.ToGameCard(0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	aura.AttachedTo = dealer.ID
+	gs.Battlefield.AddCard(aura)
+	if !V2TriggerEvents["player_damaged"] {
+		t.Fatal("event vocabulary missing")
+	}
+	def.RegisterTriggeredAbilities(aura, gs.EventBus)
+	if err := gs.ExecuteAbilityEffectDirect(0, dealer, map[string]interface{}{"effect": "damage", "amount": 1}, []game.Target{{Type: game.TargetPlayer, PlayerIdx: 1}}); err != nil {
+		t.Fatal(err)
+	}
+	if gs.PendingTriggerTarget == nil {
+		t.Fatal("DSL did not reach runtime target choice")
+	}
+	if err := gs.ResolveTriggerTargetChoice(0, victim.ID); err != nil {
+		t.Fatal(err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatal(err)
+	}
+	if !gs.Players[1].Hand.HasCard(victim.ID) {
+		t.Fatal("DSL did not resolve bounce")
+	}
+}
