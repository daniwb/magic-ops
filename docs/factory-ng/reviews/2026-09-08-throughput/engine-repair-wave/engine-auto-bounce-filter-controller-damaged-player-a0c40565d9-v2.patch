@@ -0,0 +1,92 @@
+package game
+
+import "testing"
+
+func TestShape_AuditedPlayerDamageNotifications(t *testing.T) {
+	for _, combat := range []bool{false, true} {
+		for _, prevented := range []bool{false, true} {
+			gs := NewGame("P0", "P1", false)
+			source := NewCreature("dealer", ManaCost{}, 2, 2, 0)
+			gs.Battlefield.AddCard(source)
+			seen := 0
+			gs.EventBus.Subscribe(EventPlayerDamaged, func(e *Event) {
+				seen++
+				if e.Source != source || e.Opponent != 1 || e.Amount != 2 || e.Data["is_combat"] != combat {
+					t.Error("bad event context")
+				}
+			})
+			gs.MonarchIdx = 1
+			if prevented {
+				gs.ReplacementManager.CreateSourceOnlyDamagePreventionShield(source.ID, false)
+			}
+			if combat {
+				applyCombatDamageToPlayer(gs, gs.EffectManager, source, gs.Players[1], 2)
+			} else {
+				if err := gs.ExecuteAbilityEffectDirect(0, source, map[string]interface{}{"effect": "damage", "amount": 2}, []Target{{Type: TargetPlayer, PlayerIdx: 1}}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			want := 1
+			if prevented {
+				want = 0
+			}
+			if seen != want {
+				t.Fatalf("combat=%v prevented=%v events=%d want %d", combat, prevented, seen, want)
+			}
+			if !combat && gs.MonarchIdx != 1 {
+				t.Fatal("noncombat damage transferred monarch")
+			}
+			gs.Players[1].LoseLife(1)
+			if seen != want {
+				t.Fatal("life loss emitted damage")
+			}
+		}
+	}
+}
+
+func TestShape_AuditedEnchantedDamageTarget(t *testing.T) {
+	for _, changeControl := range []bool{false, true} {
+		gs := NewGame("P0", "P1", false)
+		dealer := NewCreature("dealer", ManaCost{}, 2, 2, 0)
+		gs.Battlefield.AddCard(dealer)
+		aura := &Card{ID: "audit-aura", Type: TypeEnchantment, Name: "aura", Controller: 0, Owner: 0, AttachedTo: dealer.ID}
+		gs.Battlefield.AddCard(aura)
+		victim := NewCreature("stolen victim", ManaCost{}, 2, 2, 0)
+		victim.Controller = 1
+		gs.Battlefield.AddCard(victim)
+		ability := &TriggeredAbility{ID: "aura-trigger", SourceCard: aura, Condition: TriggerCondition{EventType: EventPlayerDamaged, SourceType: "enchanted"}, EffectSequence: []EffectAtomSpec{{Effect: "bounce", TargetType: TargetCreature, TargetQualifier: &TriggerTargetFilter{Type: "creature", Controller: "defending_player"}}}}
+		gs.EventBus.RegisterTriggeredAbility(ability)
+		if err := gs.ExecuteAbilityEffectDirect(0, dealer, map[string]interface{}{"effect": "damage", "amount": 1}, []Target{{Type: TargetPlayer, PlayerIdx: 1}}); err != nil {
+			t.Fatal(err)
+		}
+		p := gs.PendingTriggerTarget
+		if p == nil || len(p.LegalTargets) != 1 || p.LegalTargets[0].CardID != victim.ID {
+			t.Fatal("wrong damaged-player target choice")
+		}
+		if err := gs.ResolveTriggerTargetChoice(0, victim.ID); err != nil {
+			t.Fatal(err)
+		}
+		if changeControl {
+			victim.Controller = 0
+		}
+		if err := gs.ResolveTopOfStack(); err != nil {
+			t.Fatal(err)
+		}
+		if changeControl {
+			if !gs.Battlefield.HasCard(victim.ID) {
+				t.Fatal("now-illegal target bounced")
+			}
+		} else if !gs.Players[0].Hand.HasCard(victim.ID) {
+			t.Fatal("stolen target did not return to owner")
+		}
+		// An unrelated creature must not trigger the enchanted-source condition.
+		other := NewCreature("other", ManaCost{}, 2, 2, 0)
+		gs.Battlefield.AddCard(other)
+		if err := gs.ExecuteAbilityEffectDirect(0, other, map[string]interface{}{"effect": "damage", "amount": 1}, []Target{{Type: TargetPlayer, PlayerIdx: 1}}); err != nil {
+			t.Fatal(err)
+		}
+		if gs.PendingTriggerTarget != nil || !gs.Stack.IsEmpty() {
+			t.Fatal("unrelated source triggered aura")
+		}
+	}
+}
