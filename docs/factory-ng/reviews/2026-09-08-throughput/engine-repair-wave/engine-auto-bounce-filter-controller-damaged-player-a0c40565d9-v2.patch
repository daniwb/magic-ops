+func (gs *GameState) revalidatePlayerControlledTriggerTarget(obj *StackObject) bool {
+	for _, atom := range obj.EffectSequence {
+		if atom.TargetType == "" {
+			continue
+		}
+		legal := make([]Target, 0, len(obj.Targets))
+		for _, target := range obj.Targets {
+			if !IsValidTarget(target, TargetRequirement{Type: atom.TargetType}, gs, obj.Controller) {
+				continue
+			}
+			card, err := gs.Battlefield.GetCard(target.CardID)
+			if err != nil || card.Controller != *obj.TriggerTargetController {
+				continue
+			}
+			legal = append(legal, target)
+		}
+		obj.Targets = legal
+		return len(legal) > 0
+	}
+	return false
+}
diff --git a/backend/game/lib_player_damage_event.go b/backend/game/lib_player_damage_event.go
new file mode 100644
index 000000000..54684e02d
--- /dev/null
+++ b/backend/game/lib_player_damage_event.go
@@ -0,0 +1,29 @@
+package game
+
+// Player-damage observers use actual post-prevention damage, including infect,
+// independently of life loss. Combat-only observers retain their old event.
+func (gs *GameState) emitPlayerDamaged(source *Card, player, amount int, combat bool) {
+	if gs.EventBus == nil || amount <= 0 {
+		return
+	}
+	controller := -1
+	if source != nil {
+		controller = source.Controller
+	}
+	event := NewEvent(EventPlayerDamaged).WithSource(source).WithPlayer(controller).WithOpponent(player).WithAmount(amount)
+	event.Data["is_combat"] = combat
+	gs.ProcessTriggeredAbilities(event)
+}
+
+func (gs *GameState) dealNoncombatPlayerDamage(source *Card, player, amount int) int {
+	if amount <= 0 || player < 0 || player >= len(gs.Players) {
+		return 0
+	}
+	p := gs.Players[player]
+	beforeDamage, beforeLife := p.DamageTakenThisTurn, p.Life
+	_ = DamageTargetFromSource(Target{Type: TargetPlayer, PlayerIdx: player}, amount, source, gs)
+	if lost := beforeLife - p.Life; lost > 0 && gs.EventBus != nil {
+		gs.ProcessTriggeredAbilities(CreateLifeLossEvent(player, lost))
+	}
+	return p.DamageTakenThisTurn - beforeDamage
+}
diff --git a/backend/game/shape_audited_player_damage_test.go b/backend/game/shape_audited_player_damage_test.go
