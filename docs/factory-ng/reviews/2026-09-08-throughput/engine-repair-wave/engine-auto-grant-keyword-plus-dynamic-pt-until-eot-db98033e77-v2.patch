+package game
+
+import "testing"
+
+func TestShape_AuditedEventManaValuePump(t *testing.T) {
+	for _, mana := range []int{0, 4} {
+		gs := NewGame("P0", "P1", false)
+		source := NewCreature("source", ManaCost{}, 2, 2, 0)
+		gs.Battlefield.AddCard(source)
+		spell := NewInstant("spell", ManaCost{Generic: mana}, nil, 0)
+		atoms := []EffectAtomSpec{{Effect: "grant_keywords_until_eot", EffectValue: map[string]interface{}{"keyword": "trample"}}, {Effect: "pump_until_eot", EffectValue: map[string]interface{}{"target_self": true, "pt_amount_count": map[string]interface{}{"count": "event_subject_mana_value"}}}}
+		for i := 0; i < 2; i++ {
+			if err := gs.executeEffectSequenceEv(0, source, atoms, nil, 0, nil, spell, 0); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if source.GetPowerWithEffects(gs.EffectManager) != 2+2*mana || source.GetToughnessWithEffects(gs.EffectManager) != 2+2*mana || !source.HasKeywordWithEffects(Trample, gs.EffectManager) {
+			t.Fatal("sequence did not grant symmetric P/T and trample")
+		}
+		gs.CleanupEndOfTurnEffects()
+		if source.GetPowerWithEffects(gs.EffectManager) != 2 || source.GetToughnessWithEffects(gs.EffectManager) != 2 || source.HasKeywordWithEffects(Trample, gs.EffectManager) {
+			t.Fatal("effects did not expire")
+		}
+		obj := &StackObject{IsAbility: true, Card: source, Controller: 0, Text: "pump_until_eot", EventCard: spell, EffectValue: map[string]interface{}{"power_from": "referent_spell_mana_value"}}
+		if err := gs.ExecuteAbilityEffect(obj); err != nil {
+			t.Fatal(err)
+		}
+		if source.GetPowerWithEffects(gs.EffectManager) != 2+mana || source.GetToughnessWithEffects(gs.EffectManager) != 2 {
+			t.Fatal("legacy +X/+0 changed")
+		}
+	}
+}
+
+func TestShape_AuditedEventManaValueSurvivesCounteredXSpell(t *testing.T) {
+	gs := NewGame("P0", "P1", false)
+	source := NewCreature("source", ManaCost{}, 2, 2, 0)
+	gs.Battlefield.AddCard(source)
+	spell := NewInstant("X spell", ManaCost{Generic: 1, XCount: 2}, nil, 0)
+	gs.Stack.PushSpellWithTargets(spell, 0, nil)
+	cast := gs.Stack.Peek()
+	cast.EffectValue = map[string]interface{}{"x_value": 3}
+	ability := &TriggeredAbility{SourceCard: source, EffectSequence: []EffectAtomSpec{{Effect: "pump_until_eot", EffectValue: map[string]interface{}{"target_self": true, "pt_amount_count": map[string]interface{}{"count": "event_subject_mana_value"}}}}}
+	gs.PutTriggeredAbilityOnStackWithEvent(ability, CreateSpellCastEvent(spell, 0))
+	if _, err := gs.Stack.RemoveByStackID(cast.ID); err != nil {
+		t.Fatal(err)
+	}
+	if err := gs.ResolveTopOfStack(); err != nil {
+		t.Fatal(err)
+	}
+	if source.GetPowerWithEffects(gs.EffectManager) != 9 || source.GetToughnessWithEffects(gs.EffectManager) != 9 {
+		t.Fatal("announced mana value was lost")
+	}
+	if spell.ManaCost.Generic != 1 || spell.ManaCost.XCount != 2 {
+		t.Fatal("printed cost mutated")
+	}
+}
