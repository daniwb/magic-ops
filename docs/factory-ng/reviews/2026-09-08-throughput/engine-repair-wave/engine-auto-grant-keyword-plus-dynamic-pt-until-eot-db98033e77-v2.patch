@@ -0,0 +1,22 @@
+package game
+
+// Preserve the spell's announced mana value in trigger context, even when it
+// is countered before the trigger resolves. Other event subjects remain live.
+func (gs *GameState) triggerEventCard(event *Event) *Card {
+	c := event.Source
+	if c == nil || c.ManaCost.XCount == 0 {
+		return c
+	}
+	switch event.Type {
+	case EventSpellCast, EventSpellCastFromExile, EventSpellCastFromGraveyard, EventSpellCastFromLibrary:
+		for _, obj := range gs.Stack.Objects {
+			if !obj.IsAbility && obj.Card != nil && obj.Card.ID == c.ID {
+				copy := *c
+				copy.ManaCost.Generic += c.ManaCost.XCount * getIntValue(obj.EffectValue, "x_value", 0)
+				copy.ManaCost.XCount = 0
+				return &copy
+			}
+		}
+	}
+	return c
+}
diff --git a/backend/game/shape_audited_event_mana_value_test.go b/backend/game/shape_audited_event_mana_value_test.go
