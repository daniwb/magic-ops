diff --git a/backend/cards/shape_audited_target_count_test.go b/backend/cards/shape_audited_target_count_test.go
new file mode 100644
index 000000000..1f9dcc522
--- /dev/null
+++ b/backend/cards/shape_audited_target_count_test.go
@@ -0,0 +1,88 @@
+package cards
+
+import (
+	"encoding/json"
+	"magic-backend/game"
+	"testing"
+)
+
+func TestShape_AuditedTargetCountConversionAndCasting(t *testing.T) {
+	for _, n := range []int{0, 1, 3, 4} {
+		for _, alt := range []bool{false, true} {
+			gs := game.NewGame("P0", "P1", false)
+			gs.PrioritySystem.GivePriority(0)
+			// Exercise the JSON schema boundary, converter and actual cast API.
+			var def CardDefinition
+			if err := json.Unmarshal([]byte(`{"name":"Bounded tap","type":"Instant","abilities":[{"type":"spell","effects":[{"effect":"tap_target_creatures","target":{"filter":"nonflying_creature","min_targets":0,"max_targets":3}}]}]}`), &def); err != nil {
+				t.Fatal(err)
+			}
+			spell, err := def.ToGameCard(0)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if spell.SpellEffect == nil || spell.SpellEffect.MaxTargets != 3 || spell.SpellEffectSequence[0].TargetType != "nonflying_creature" {
+				t.Fatal("bounds or type lost in conversion")
+			}
+			gs.Players[0].Hand.AddCard(spell)
+			var targets []game.Target
+			var creatures []*game.Card
+			for i := 0; i < n; i++ {
+				c := game.NewCreature("target", game.ManaCost{}, 2, 2, 1)
+				gs.Battlefield.AddCard(c)
+				creatures = append(creatures, c)
+				targets = append(targets, game.Target{IsCard: true, CardID: c.ID})
+			}
+			grantor := game.NewCreature("grantor", game.ManaCost{}, 2, 2, 0)
+			grantor.AltCostZeroColorlessFromHand = true
+			grantor.AltCostZeroOncePerTurn = true
+			grantor.AltCostZeroUsedTurn = -1
+			gs.Battlefield.AddCard(grantor)
+			if alt {
+				err = gs.CastSpellWithGrantedAltCostZero(0, spell.ID, grantor.ID, targets)
+			} else {
+				err = gs.CastSpellWithTargets(0, spell.ID, targets)
+			}
+			if n == 4 {
+				if err == nil {
+					t.Fatal("accepted four targets")
+				}
+				if !gs.Players[0].Hand.HasCard(spell.ID) || !gs.Stack.IsEmpty() || grantor.AltCostZeroUsedTurn != -1 {
+					t.Fatal("invalid cast mutated state")
+				}
+				continue
+			}
+			if err != nil {
+				t.Fatalf("n=%d alt=%v: %v", n, alt, err)
+			}
+			// A target that gains flying after casting must be skipped.
+			if n == 3 {
+				creatures[0].Keywords = append(creatures[0].Keywords, game.Flying)
+			}
+			if err := gs.ResolveTopOfStack(); err != nil {
+				t.Fatal(err)
+			}
+			for i, c := range creatures {
+				if c.Tapped != (n != 3 || i != 0) {
+					t.Fatal("resolved wrong selection")
+				}
+			}
+		}
+	}
+}
+
+func TestShape_AuditedTargetCountRejectsDuplicateAndKeepsLegacyRequiredTarget(t *testing.T) {
+	gs := game.NewGame("P0", "P1", false)
+	gs.PrioritySystem.GivePriority(0)
+	c := game.NewCreature("target", game.ManaCost{}, 2, 2, 1)
+	gs.Battlefield.AddCard(c)
+	spell := game.NewInstant("bounded", game.ManaCost{}, &game.SpellEffect{Type: "seq_target_stub", SpellTargetType: game.TargetCreature, MaxTargets: 3}, 0)
+	gs.Players[0].Hand.AddCard(spell)
+	target := game.Target{IsCard: true, CardID: c.ID}
+	if err := gs.CastSpellWithTargets(0, spell.ID, []game.Target{target, target}); err == nil {
+		t.Fatal("duplicate target accepted")
+	}
+	spell.SpellEffect.MaxTargets = 0
+	if err := gs.CastSpellWithTargets(0, spell.ID, nil); err == nil {
+		t.Fatal("legacy required target became optional")
+	}
+}
