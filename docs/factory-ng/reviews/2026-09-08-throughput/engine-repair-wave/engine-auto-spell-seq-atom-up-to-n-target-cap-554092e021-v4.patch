diff --git a/backend/game/lib_spell_target_selection.go b/backend/game/lib_spell_target_selection.go
new file mode 100644
index 000000000..c48de95f2
--- /dev/null
+++ b/backend/game/lib_spell_target_selection.go
@@ -0,0 +1,42 @@
+package game
+
+import "fmt"
+
+// Validate the declaration before a casting path spends resources. Legacy
+// effects without explicit bounds retain their existing cardinality behavior.
+func (gs *GameState) validateSpellTargetSelection(card *Card, controller int, targets []Target) error {
+	effect := card.SpellEffect
+	if effect == nil || effect.SpellTargetType == "" {
+		return nil
+	}
+	if effect.MaxTargets != 0 || effect.MinTargets != 0 {
+		if effect.MinTargets < 0 || effect.MaxTargets < 1 || effect.MinTargets > effect.MaxTargets {
+			return fmt.Errorf("%s: invalid target-count requirement", card.Name)
+		}
+		if len(targets) < effect.MinTargets || len(targets) > effect.MaxTargets {
+			return fmt.Errorf("%s: choose %d to %d targets", card.Name, effect.MinTargets, effect.MaxTargets)
+		}
+		seen := map[string]bool{}
+		for _, target := range targets {
+			key := fmt.Sprintf("player:%d", target.PlayerIdx)
+			if target.IsCard {
+				key = "card:" + target.CardID
+			}
+			if target.StackID != "" {
+				key = "stack:" + target.StackID
+			}
+			if seen[key] {
+				return fmt.Errorf("%s: duplicate target", card.Name)
+			}
+			seen[key] = true
+		}
+	} else if len(targets) == 0 {
+		return fmt.Errorf("%s: this spell requires a target", card.Name)
+	}
+	for _, target := range targets {
+		if !IsValidTarget(target, TargetRequirement{Type: effect.SpellTargetType}, gs, controller) {
+			return fmt.Errorf("%s: invalid target — must target %s", card.Name, effect.SpellTargetType)
+		}
+	}
+	return nil
+}
