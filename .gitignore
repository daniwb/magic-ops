# Secrets — niemals committen
*.key
*.secret
*.deepseek_key
.env
.credentials.json
# Runtime SQLite (Dispatcher) — nie tracken (git clean würde offene DB zerschiessen)
*.db
*.db-wal
*.db-shm
*.db-journal
# Kompilierte Binaries
services/dispatcher/v4/dispatcher-v4
services/dispatcher/v4/.dispatcher-v4.bak-*
dispatcher-v4
*.exe
bin/
# Logs / Caches / Python
*.log
logs/
__pycache__/
*.pyc
# kompilierte Dispatcher-Binary (jeder Name, nicht nur -v4)
services/dispatcher/dispatcher
# Runtime-State
state.json
.venv/
venv-litellm/
magic_ops/
__pycache__/
record-candidates/
*.log
LOCAL_GPU_OFF
catalog-mode-orch-*
haiku-rounds-orch-*
plan_attemory_integration.md
requirements.txt
state/
# Factory NG generated artifacts (receipts, tickets, patches, measurements).
# Written continuously by producers/controller; kept on disk, not in history.
# Files tracked before this rule stay tracked; force-add (git add -f) to keep one.
docs/factory-ng/runs/
docs/factory-ng/tickets/
docs/factory-ng/job-archive/
docs/factory-ng/measurements/
docs/factory-ng/candidates/
